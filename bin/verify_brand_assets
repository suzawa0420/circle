require 'json'

root = File.expand_path('..', __dir__)
manifests = Dir[File.join(root, 'public/assets/.sprockets-manifest-*.json')]
abort 'Asset verification failed: no manifest' if manifests.empty?

# Only the manifest produced by the current precompile run is relevant. Older
# manifests can remain on a developer machine after unrelated revisions.
path = manifests.max_by { |candidate| File.mtime(candidate) }
manifest = JSON.parse(File.read(path))
asset = manifest.fetch('assets').fetch('application.css')
css = File.read(File.join(root, 'public/assets', asset))

header_is_compact = css.match?(/\.header_wrap\s*\{[^}]*height:\s*60px/m)
menu_is_neutral = css.match?(/\.header_wrap \.header-menus_sp\s*\{[^}]*background:\s*#f5f6f7/m)
hamburger_is_visible = css.match?(/\.header_wrap #nav-open span,[\s\S]*?background:\s*#656b73/m)

unless header_is_compact && menu_is_neutral && hamburger_is_visible
  abort 'Asset verification failed: application.css is missing the compact header styles'
end
puts 'Brand asset verification passed'
