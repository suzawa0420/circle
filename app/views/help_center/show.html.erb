<% set_meta_tags title: "#{@article[:title]}｜ヘルプセンター" %>
<main class="help-shell">
  <%= link_to 'ヘルプセンターに戻る', faq_path %>
  <article class="help-card"><p class="help-eyebrow"><%= HelpCatalog::CATEGORIES[@article[:category]] %> ／ <%= HelpCatalog::AUDIENCES[@article[:audience]] %></p><h1><%= @article[:title] %></h1><%= render "answer", article: @article %><% if %w[message-notification owner-reply message-reply-missing].include?(@article[:id]) %>
    <nav class="help-links" aria-label="メッセージのログイン・関連する案内">
      <%= link_to '主催者ログイン（サークルを管理する方）', new_admin_user_session_path %>
      <%= link_to '参加者ログイン（サークルへ問い合わせた方）', new_member_session_path %>
      <% if @article[:id] == 'message-reply-missing' %>
        <%= link_to '参加者・主催者のメッセージ確認・返信手順', help_article_path('message-notification') %>
      <% else %>
        <%= link_to '返信欄が表示されない・メッセージを送信できない', help_article_path('message-reply-missing') %>
      <% end %>
    </nav>
  <% end %>
  <% if @article[:id] == 'inquiry-method' %>
    <nav class="help-links" aria-label="問い合わせ方法の関連FAQ">
      <%= link_to 'サイト内チャットの確認・返信方法', help_article_path('message-notification') %>
      <%= link_to 'サークル紹介文の編集方法', help_article_path('edit-listing') %>
    </nav>
  <% elsif %w[contact-circle message-notification inquiry-guidance].include?(@article[:id]) %>
    <p><%= link_to '公式LINE・フォーム・メールの問い合わせ受付方式について', help_article_path('inquiry-method') %></p>
  <% end %>
  <% label, path = help_action(@article) %><%= link_to label, path, class: 'cb-button' %></article>
  <section class="help-card"><h2>この回答で解決できましたか？</h2><%= form_with url: help_feedback_path(@article[:id]), method: :post, local: true do %><%= hidden_field_tag :spam_form_token, spam_form_token("help-feedback:#{@article[:id]}") %><div class="help-actions"><%= button_tag '解決できた', name: 'answer', value: 'helpful', class: 'cb-button' %><%= button_tag '解決しなかった', name: 'answer', value: 'unhelpful', class: 'cb-button cb-button--secondary' %></div><% end %></section>
  <% if @article[:id] == 'report' %><section class="help-card"><h2>通報する画面にアクセスできない場合</h2><%= link_to '安全上の問題を運営に報告する', new_support_request_path(kind: 'safety', category: 'review'), class: 'cb-button' %></section><% end %>
  <%= render 'help_center/contact_options', category: @article[:category] %>
</main>
