- place = record
.home-place.home-preview
  .home-place__top
    %span.home-place__sports= place.events.map(&:name).join("・")
    %span.home-place__status= place.tag.to_i == 1 ? "屋内" : "屋外"
  %h3= place.name.to_s.truncate(40)
  %p.home-place__area= [place.prefecture.name, place.city.name].join("・")
  %dl.home-place__details
    - [["住所", place.address], ["アクセス", place.access], ["利用時間", place.time]].each do |label, value|
      .home-place__row
        %dt= label
        %dd= strip_tags(value.to_s).presence || "詳細ページで確認"
  = link_to "詳細を確認する", "/places/#{place.events.first.ruby}/#{place.prefecture.kana}/#{place.city.city_kana}/#{place.id}", class: "home-place__link"
