- blog = record
.blog-body.home-preview
  = link_to circle_blog_path(blog.user_id, blog) do
    .header-post
      = circle_avatar_tag blog.user, class: "content_icon"
      .post-user_wrap
        .post-user
          .post-top= blog.user.name.to_s.truncate(30)
          .post-bottom 更新日：#{time_tag blog.updated_at.to_date}
    - if blog.image_01.present?
      .post-body= image_tag blog.image_01.url, class: "content_image_one", alt: "", loading: "lazy"
    .home-preview__body
      %h3.blog_title= blog.title.to_s.truncate(40)
      %p.home-preview__excerpt= strip_tags(blog.content.to_s).squish.truncate(110)
      .blog_tag
        %span.tag_btn
          = lucide_icon "tags"
          = blog.user.event&.name
        %span.tag_btn
          = lucide_icon "map-pin"
          = blog.user.prefecture&.name
