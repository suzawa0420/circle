- set_meta_tags title: "サークル・イベント・活動ブログ・対戦相手・コート体育館を探す", description: "サークルブックで好きな活動を見つけよう。サークルのメンバー募集、今日のイベント、活動ブログ、対戦相手の募集、コート・体育館情報を探せます。"
= render "users/parts/local_business_user_list"
%main.home-portal
  .home-portal__container
    .home-portal__hero
      %p.home-portal__eyebrow 好きなことを、一緒に。
      %h1 好きな活動を、ここから。
      %p 仲間も、イベントも、活動の場所も。目的に合わせて探そう。
    %nav.home-portal__services{"aria-label" => "目的から探す"}
      - home_services.each do |service|
        = link_to service[:path], class: "home-service home-service--#{service[:key]}" do
          = lucide_icon service[:icon]
          %span= service[:title]

    - home_services.each do |service|
      %section.home-portal__section{id: "home-#{service[:key]}", "aria-labelledby" => "home-#{service[:key]}-title"}
        .home-portal__heading
          .home-portal__heading-copy
            %h2{id: "home-#{service[:key]}-title"}
              = lucide_icon service[:icon]
              = service[:title]
            %p= service[:description]
          %span.home-portal__label= service[:label]
        - records = { "circles" => @users, "events" => @schedules, "blogs" => @blogs, "matches" => @matches, "places" => @places }.fetch(service[:key])
        - if records.any?
          %p.home-portal__slide-hint
            横にスライドして見る
            = lucide_icon "chevron-right"
          %ul.home-portal__rail{tabindex: "0", "aria-label" => "#{service[:title]}の掲載一覧"}
            - records.each_with_index do |record, index|
              %li.home-portal__item{class: "home-portal__item--#{service[:key]}"}
                - if service[:key] == "events"
                  - key, label = @day_listing.status(record)
                  = render "schedules/event_card", schedule: record, user: record.user, status: { key: key, label: label }, eager: false
                - else
                  = render "home/#{service[:key]}_card", record: record, index: index
        - else
          .home-portal__empty
            - if service[:key] == "events"
              %p 今日のイベントはまだありません。ほかの開催日も探してみましょう。
            - else
              %p 掲載情報はまだありません。一覧ページから条件を選んで探せます。
        = link_to service[:path], class: "home-portal__more" do
          = service[:more]
          = lucide_icon "chevron-right"
