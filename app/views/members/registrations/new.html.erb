<% set_meta_tags title: '無料参加者登録', noindex: true %>
<main class="participant-shell participant-shell--narrow participant-signup">
  <div class="participant-heading"><p class="participant-eyebrow">サークルに参加する方</p><h1>無料参加者登録</h1></div>
  <section class="participant-signup__welcome" aria-labelledby="participant-signup-welcome">
    <div>
      <span class="participant-signup__badge">ずっと無料</span>
      <h2 id="participant-signup-welcome">入力は最短30秒。<br>気になるサークルへ、第一歩！</h2>
      <p>確認メールのリンクを押すだけで、<br>保存・お問い合わせ・メッセージが使えます。</p>
    </div>
    <img src="/images/mascot/squirrel-joy.png" width="104" height="104" alt="本を掲げて喜ぶサークルブックのリス">
  </section>
  <section class="participant-signup__guide" aria-labelledby="participant-signup-steps">
    <h2 id="participant-signup-steps">かんたん3ステップではじめよう</h2>
    <ol class="participant-signup__steps">
      <li><span class="participant-signup__number" aria-hidden="true">1</span><strong>情報を入力</strong><p>ニックネーム・メール・パスワードを設定</p></li>
      <li><span class="participant-signup__number" aria-hidden="true">2</span><strong>メールを確認</strong><p>届いた確認メールのリンクをクリック</p></li>
      <li><span class="participant-signup__number" aria-hidden="true">3</span><strong>すぐ使える！</strong><p>保存やお問い合わせをはじめよう</p></li>
    </ol>
  </section>
  <div class="participant-card">
    <h2>まずは情報を入力</h2>
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: 'participant-form' }) do |f| %>
      <%= render 'shared/spam_protection', scope: "registration:#{resource_name}" %>
      <%= render 'devise/shared/error_messages', resource: resource %>
      <div class="participant-signup__verification"><%= render 'devise/shared/registration_bot_guard' %></div>
      <div class="participant-field"><%= f.label :nickname, 'ニックネーム' %><%= f.text_field :nickname, required: true, maxlength: 30, autocomplete: 'nickname' %><p class="participant-help">公開プロフィールや口コミに表示されます。</p></div>
      <div class="participant-field"><%= f.label :email, 'メールアドレス' %><%= f.email_field :email, required: true, autocomplete: 'email' %></div>
      <div class="participant-field"><%= f.label :password, 'パスワード' %><%= f.password_field :password, required: true, minlength: @minimum_password_length, autocomplete: 'new-password' %><p class="participant-help"><%= @minimum_password_length %>文字以上で設定してください。</p></div>
      <div class="participant-field"><%= f.label :password_confirmation, 'パスワード（確認）' %><%= f.password_field :password_confirmation, required: true, autocomplete: 'new-password' %></div>
      <p class="participant-help">登録すると<%= link_to '利用規約', rules_path %>に同意したものとします。</p>
      <%= f.submit '無料で登録する', class: 'participant-button participant-button--wide', data: { disable_with: '登録中…' } %>
      <p class="participant-help participant-signup__mail-note">登録後に確認メールをお送りします。</p>
    <% end %>
    <p class="participant-auth-switch"><%= link_to '登録済みの方はログイン', new_member_session_path %></p>
  </div>
</main>
