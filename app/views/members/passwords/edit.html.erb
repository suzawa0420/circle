<% set_meta_tags title: '新しいパスワードの設定', noindex: true %>
<main class="participant-shell participant-shell--narrow"><div class="participant-heading"><p class="participant-eyebrow">サークル参加者</p><h1>新しいパスワード</h1></div><div class="participant-card">
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: 'participant-form' }) do |f| %>
    <%= render 'devise/shared/error_messages', resource: resource %><%= f.hidden_field :reset_password_token %>
    <div class="participant-field"><%= f.label :password, '新しいパスワード' %><%= f.password_field :password, required: true, minlength: @minimum_password_length, autocomplete: 'new-password' %></div>
    <div class="participant-field"><%= f.label :password_confirmation, '新しいパスワード（確認）' %><%= f.password_field :password_confirmation, required: true, autocomplete: 'new-password' %></div>
    <%= f.submit 'パスワードを変更する', class: 'participant-button participant-button--wide' %>
  <% end %>
</div></main>
