%li
  #nav-drawer
    %input#nav-input.nav-unshown{:type => "checkbox"}/
    %label#nav-open{:for => "nav-input"}
      %span
    %label#nav-close.nav-unshown{:for => "nav-input"}
    #nav-content
      .logo_txt
        = link_to root_path do
          %img.img_logo_memu{:alt => "サークルブック", :src => "/images/logo.png?v=20260921-green-clean", :width => 960, :height => 251}/
      - if webmaster?
        .menu_btn= link_to "運営管理トップ", webmaster_path
      - elsif member_signed_in?
        .menu_btn.cb-participant= link_to 'マイページ', member_path(current_member)
      - elsif admin_user_signed_in?
        - if current_admin_user.users.any?
          .menu_btn= link_to 'マイページ', "/users/#{current_admin_user.users.first.id}/mypage"
      - elsif exhibition_group_signed_in?
      - else
        = render 'layouts/account_access', in_menu: true


      %ul
        %li= link_to 'サークル検索', circles_path
        %li= link_to '対戦相手を探す', matches_path
        %li= link_to 'コート・体育館を探す', '/places'



      - if webmaster?
        %ul
          %li= link_to "運営ログアウト", destroy_webmaster_session_path, method: :delete
      - elsif member_signed_in?
        %ul
          %li= link_to 'ログアウト', destroy_member_session_path, method: :delete
          %li
            = link_to edit_member_registration_path do
              メールアドレス
              %br>/
              パスワードの変更
      - elsif admin_user_signed_in?
        %ul
          %li= link_to 'ログアウト', destroy_admin_user_session_path, method: :delete
          %li
            = link_to edit_admin_user_registration_path do
              メールアドレス
              %br>/
              パスワードの変更
      - elsif exhibition_group_signed_in?
        %ul
          %li= link_to 'ログアウト', destroy_exhibition_group_session_path, method: :delete

      .menu_contact
        %p 主催者/参加者のアカウント問わず、X（旧Twitter）のDMからお問い合わせください。
        = link_to 'https://x.com/circlebook03', class: 'menu_contact_x', target: '_blank', rel: 'noopener noreferrer', aria: { label: 'サークルブックのX（旧Twitter）を開く' } do
          X（旧：Twitter）

  .link_txt メニュー
