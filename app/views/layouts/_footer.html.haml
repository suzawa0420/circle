.footer_wrap
  - unless event_breadcrumb_in_content?
    = render "/layouts/breadcrumb"
  %ul.footer_links
    %li
      %a{:href => "/faq"} ヘルプ・よくある質問
    %li
      %a{:href => "/about"} サークルブックについて
    %li
      %a{:href => "/rules"} 利用規約
    %li
      %a{:href => "/privacypolicy"} プライバシーポリシー
    %li
      %button.home-screen-install-button{ type: "button", hidden: true, "data-home-screen-install" => true, "aria-haspopup" => "dialog", "aria-controls" => "home-screen-install-dialog" }
        = lucide_icon "plus"
        ホーム画面に追加
  .footer_copyright
    .footer_logo
      = link_to root_path do
        %picture
          - if fast_public_listing?
            %source{ srcset: "/images/listing-logo-320-v2.webp 320w, /images/listing-logo-640-v2.webp 640w", sizes: "(max-width: 767px) 120px, 160px", type: "image/webp" }
          %img.footer_logo_img{:alt => "サークルブック", :src => "/images/logo.png?v=20260921-green-clean", :width => 960, :height => 251}/
    .footer_copyright_address
      Copyright (c) #{link_to "サークルブック", root_path}
