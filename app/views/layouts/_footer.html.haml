.footer_wrap
  - gretel_breadcrumbs = breadcrumbs separator: "&rsaquo;"
  - if gretel_breadcrumbs.any?
    .breadcrumbs_wrapper.text_slide
      .breadcrumbs
        = gretel_breadcrumbs
  - else
    = render "/layouts/breadcrumb"
  %ul.footer_links
    %li
      %a{:href => "/faq"} よくある質問
    %li
      %a{:href => "/about"} サークルブックについて
    %li
      %a{:href => "/rules"} 利用規約
    %li
      %a{:href => "/privacypolicy"} プライバシーポリシー
  .footer_copyright
    .footer_logo
      = link_to root_path do
        %picture
          - if fast_public_listing?
            %source{ srcset: "/images/listing-logo-v1.webp", type: "image/webp" }
          %img.footer_logo_img{:alt => "サークルブック", :src => "/images/logo.png?v=20260921-green-clean", :width => 960, :height => 251}/
    .footer_copyright_address
      Copyright (c) #{link_to "サークルブック", root_path}
