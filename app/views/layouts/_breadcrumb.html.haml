- breadcrumb_items = site_breadcrumb_items
.breadcrumbs_wrapper
  %nav.breadcrumbs{ "aria-label" => "パンくずリスト" }
    %ol
      - breadcrumb_items.each_with_index do |(name, path), index|
        %li
          - if index.positive?
            = lucide_icon "chevron-right", class: "breadcrumb-separator", "aria-hidden" => "true"
          - if path.present?
            = link_to path do
              - if index.zero?
                = lucide_icon "house", class: "home_icon", "aria-hidden" => "true"
              = name
          - elsif index == breadcrumb_items.length - 1
            %span.breadcrumb-current{ "aria-current" => "page" }= name
          - else
            %span= name
- unless event_breadcrumb_in_content?
  - if (breadcrumb_data = site_breadcrumb_structured_data(breadcrumb_items))
    %script{ type: "application/ld+json" }= raw json_escape(breadcrumb_data.to_json)
