- unread = mobile_navigation_unread_count
= link_to conversations_path, class: "mobile-bottom-nav__item #{'cb-participant' if member_signed_in? && !admin_user_signed_in?} #{'is-active' if controller_path == 'conversations'}", "aria-label" => unread.positive? ? "メッセージ（未読#{unread}件）" : "メッセージ（未読なし）" do
  %span.mobile-bottom-nav__icon
    = lucide_icon "message-circle", **{ "aria-hidden" => "true" }
    - if unread.positive?
      %span.mobile-bottom-nav__badge{ "aria-hidden" => "true" }= unread > 99 ? "99+" : unread
  %span メッセージ
