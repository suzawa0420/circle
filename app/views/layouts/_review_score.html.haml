%ul.review_set
  %li.star_wrap
    = render "layouts/review_stars", review_score: review_score, reviews_count: reviews_count
  %li.review_score= sprintf("%.2f", review_score )
  %li.review_count.review_index
    = lucide_icon "message-circle-more"
    %span.reviews_count
      = reviews_count
      件
