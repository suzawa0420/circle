%ul.review_set
  %li.star_wrap
    - if review_score >= 4.5
      / 5.0
      %span.star
        = lucide_icon "star", class: "orange"
        = lucide_icon "star", class: "orange"
        = lucide_icon "star", class: "orange"
        = lucide_icon "star", class: "orange"
        = lucide_icon "star", class: "orange"
    - elsif review_score >= 3.5
      / 4.0
      %span.star
        = lucide_icon "star", class: "orange"
        = lucide_icon "star", class: "orange"
        = lucide_icon "star", class: "orange"
        = lucide_icon "star", class: "orange"
        = lucide_icon "star", class: "gray"
    - elsif review_score >= 2.5
      / 3.0
      %span.star
        = lucide_icon "star", class: "orange"
        = lucide_icon "star", class: "orange"
        = lucide_icon "star", class: "orange"
        = lucide_icon "star", class: "gray"
        = lucide_icon "star", class: "gray"
    - elsif review_score >= 1.5
      / 2.0
      %span.star
        = lucide_icon "star", class: "orange"
        = lucide_icon "star", class: "orange"
        = lucide_icon "star", class: "gray"
        = lucide_icon "star", class: "gray"
        = lucide_icon "star", class: "gray"
    - elsif review_score >= 0.5
      / 1.0
      %span.star
        = lucide_icon "star", class: "orange"
        = lucide_icon "star", class: "gray"
        = lucide_icon "star", class: "gray"
        = lucide_icon "star", class: "gray"
        = lucide_icon "star", class: "gray"
    - else
      / 0
      %span.star
        = lucide_icon "star", class: "gray"
        = lucide_icon "star", class: "gray"
        = lucide_icon "star", class: "gray"
        = lucide_icon "star", class: "gray"
        = lucide_icon "star", class: "gray"
  %li.review_score= sprintf("%.2f", review_score )
  %li.review_count.review_index
    = lucide_icon "message-circle-more"
    %span.reviews_count
      = reviews_count
      件
