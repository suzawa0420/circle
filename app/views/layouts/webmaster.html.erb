<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <meta name="turbolinks-cache-control" content="no-cache">
  <title>ウェブマスター管理 | サークルブック</title>
  <%= csrf_meta_tags %><%= csp_meta_tag %>
  <%= stylesheet_link_tag 'application', media: 'all' %>
  <%= javascript_include_tag 'application', defer: true %>
</head>
<body class="webmaster-page">
  <nav class="webmaster-nav" aria-label="運営管理">
    <%= link_to 'サークルブック', root_path %>
    <% if webmaster? %>
      <%= link_to '管理トップ', webmaster_path %>
      <%= link_to '口コミ管理', super_admin_reviews_path %>
      <%= button_to 'ログアウト', destroy_webmaster_session_path, method: :delete %>
    <% end %>
  </nav>
  <% if webmaster? %>
    <nav class="webmaster-subnav" aria-label="管理機能">
      <% webmaster_navigation_items.each do |label, path, count| %>
        <%= link_to path, class: "webmaster-subnav__item#{' webmaster-subnav__item--pending' if count.positive?}",
                    'aria-current': (request.path == path ? 'page' : nil),
                    'aria-label': (count.positive? ? "#{label}：未対応・確認待ち#{count}件" : label) do %>
          <span><%= label %></span>
          <% if count.positive? %><span class="webmaster-subnav__count" aria-hidden="true" title="未対応・確認待ち<%= count %>件"><%= count > 99 ? '99+' : count %></span><% end %>
        <% end %>
      <% end %>
    </nav>
  <% end %>
  <main class="webmaster-content">
    <% flash.each do |type, message| %>
      <% if %w[notice alert].include?(type) %><p class="webmaster-flash <%= "webmaster-flash--warning" if type == "alert" %>" role="status"><%= message %></p><% end %>
    <% end %>
    <%= yield %>
    <%= render "layouts/breadcrumb" %>
  </main>
  <% if webmaster? %><%= render "layouts/mobile_nav" %><% end %>
</body>
</html>
