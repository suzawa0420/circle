.mobile-site-heading
  = link_to root_path, class: "mobile-site-heading__brand", "aria-label" => "サークルブック ホーム" do
    %img{ src: "/images/logo.png?v=20260921-green-clean", alt: "サークルブック", width: 960, height: 251 }
  - if webmaster?
    = link_to "運営管理", webmaster_path, class: "mobile-site-heading__cta"
  - elsif admin_user_signed_in?
    - circle = current_admin_user.users.first
    - if circle
      = link_to "マイページ", "/users/#{circle.id}/mypage", class: "mobile-site-heading__cta"
    - else
      = link_to "登録を完了する", new_user_path, class: "mobile-site-heading__cta"
  - elsif member_signed_in?
    = link_to "マイページ", member_path(current_member), class: "mobile-site-heading__cta"
  - elsif exhibition_group_signed_in?
    = link_to "マイページ", exhibitor_mypage_path, class: "mobile-site-heading__cta"
  - else
    = link_to "登録・ログイン", login_path, class: "mobile-site-heading__cta"
