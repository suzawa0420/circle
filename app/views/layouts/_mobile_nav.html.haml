%nav.mobile-bottom-nav{ "aria-label" => "サイトのメインメニュー" }
  - if admin_user_signed_in?
    - circle = mobile_navigation_circle
    - if circle && mobile_circle_switcher?
      %button.mobile-bottom-nav__item.mobile-bottom-nav__circle.mobile-circle-trigger{ type: "button", "aria-controls" => "mobile-circle-dialog", "aria-haspopup" => "dialog", "aria-expanded" => "false", "aria-label" => "管理するサークルを切り替え（現在：#{circle.name}）" }
        = render "layouts/mobile_circle_avatar", circle: circle
        %span= circle.name
    = render "layouts/mobile_message_link"
    = link_to circle ? user_schedules_path(circle) : new_user_path, class: "mobile-bottom-nav__item #{'is-active' if controller_path == 'schedules'}" do
      %i.fa.fa-calendar{ "aria-hidden" => "true" }
      %span スケジュール
    = link_to circle ? new_circle_blog_path(circle) : new_user_path, class: "mobile-bottom-nav__item #{'is-active' if controller_path == 'circles/blogs'}" do
      %i.fa.fa-book{ "aria-hidden" => "true" }
      %span ブログ
  - elsif member_signed_in?
    = link_to circles_path, class: "mobile-bottom-nav__item #{'is-active' if @path == 'circles/circles#index'}" do
      %i.fa.fa-search{ "aria-hidden" => "true" }
      %span サークル検索
    = render "layouts/mobile_message_link"
    = link_to member_path(current_member, anchor: "favorites"), class: "mobile-bottom-nav__item" do
      %i.fa.fa-bookmark{ "aria-hidden" => "true" }
      %span お気に入り
  - else
    = link_to circles_path, class: "mobile-bottom-nav__item #{'is-active' if @path == 'circles/circles#index'}" do
      %i.fa.fa-search{ "aria-hidden" => "true" }
      %span サークル検索
    = link_to login_path, class: "mobile-bottom-nav__item mobile-bottom-nav__item--register" do
      %i.fa.fa-user-plus{ "aria-hidden" => "true" }
      %span 無料登録・ログイン

  %button.mobile-bottom-nav__item.mobile-menu-trigger{ type: "button", "aria-controls" => "mobile-menu-dialog", "aria-haspopup" => "dialog", "aria-expanded" => "false" }
    %i.fa.fa-bars{ "aria-hidden" => "true" }
    %span メニュー

- if admin_user_signed_in? && mobile_circle_switcher? && mobile_navigation_circle
  = render "layouts/mobile_circle_switcher", selected_circle: mobile_navigation_circle

%dialog#mobile-menu-dialog.mobile-menu-dialog{ "aria-labelledby" => "mobile-menu-title" }
  .mobile-menu-panel__header
    %h2#mobile-menu-title メニュー
    %button.mobile-menu-close{ type: "button", "aria-label" => "メニューを閉じる", autofocus: true }
      %i.fa.fa-times{ "aria-hidden" => "true" }
  .mobile-menu-panel__body
    .mobile-menu-panel__group
      %strong 探す
      = link_to "サークルを探す", circles_path
      = link_to "活動ブログを探す", blogs_path
      = link_to "対戦相手を探す", matches_path
      = link_to "コート・体育館", "/places"
    .mobile-menu-panel__group
      %strong アカウント
      - if member_signed_in? || admin_user_signed_in?
        = link_to "メッセージ", conversations_path
      - if webmaster?
        = link_to "運営管理トップ", webmaster_path
        = link_to "口コミ管理", super_admin_reviews_path
      - elsif admin_user_signed_in? && current_admin_user.users.any?
        = link_to "マイページ", "/users/#{mobile_navigation_circle.id}/mypage"
      - elsif member_signed_in?
        = link_to "マイページ", member_path(current_member)
        = link_to "サークルを登録", new_admin_user_registration_path
      - elsif exhibition_group_signed_in?
        = link_to "マイページ", exhibitor_mypage_path
        = link_to "サークルを登録", new_admin_user_registration_path
      - elsif admin_user_signed_in?
        = link_to "サークルを登録", new_user_path
      - else
        = render "layouts/mobile_account_access"
    .mobile-menu-panel__group.mobile-menu-panel__group--support
      %strong サポート
      = link_to "よくある質問", faq_path
    - if webmaster? || member_signed_in? || admin_user_signed_in? || exhibition_group_signed_in?
      .mobile-menu-panel__logout
        - if webmaster?
          = button_to destroy_webmaster_session_path, method: :delete do
            運営ログアウト
        - elsif member_signed_in?
          = button_to destroy_member_session_path, method: :delete do
            ログアウト
        - elsif admin_user_signed_in?
          = button_to destroy_admin_user_session_path, method: :delete do
            ログアウト
        - elsif exhibition_group_signed_in?
          = button_to destroy_exhibition_group_session_path, method: :delete do
            ログアウト
