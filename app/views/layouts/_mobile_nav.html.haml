%nav.mobile-bottom-nav{ "aria-label" => "サイトのメインメニュー" }
  = link_to circles_path, class: "mobile-bottom-nav__item #{'is-active' if @path == 'circles/circles#index'}" do
    %i.fa.fa-search{ "aria-hidden" => "true" }
    %span サークル

  = link_to blogs_path, class: "mobile-bottom-nav__item" do
    %i.fa.fa-book{ "aria-hidden" => "true" }
    %span 活動ブログ
  = link_to matches_path, class: "mobile-bottom-nav__item" do
    %i.fa.fa-users{ "aria-hidden" => "true" }
    %span 対戦相手
  = link_to "/places", class: "mobile-bottom-nav__item" do
    %i.fa.fa-map-marker{ "aria-hidden" => "true" }
    %span コート情報

  %button.mobile-bottom-nav__item.mobile-menu-trigger{ type: "button", "aria-controls" => "mobile-menu-dialog", "aria-haspopup" => "dialog", "aria-expanded" => "false" }
    %i.fa.fa-bars{ "aria-hidden" => "true" }
    %span メニュー

%dialog#mobile-menu-dialog.mobile-menu-dialog{ "aria-labelledby" => "mobile-menu-title" }
  .mobile-menu-panel__header
    %h2#mobile-menu-title メニュー
    %button.mobile-menu-close{ type: "button", "aria-label" => "メニューを閉じる", autofocus: true }
      %i.fa.fa-times{ "aria-hidden" => "true" }
  .mobile-menu-panel__body
    .mobile-menu-panel__group
      %strong 探す
      = link_to "サークルを探す", circles_path
      = link_to "活動ブログを探す", blogs_path
      = link_to "対戦相手を探す", matches_path
      = link_to "コート・体育館", "/places"
    .mobile-menu-panel__group
      %strong アカウント
      - if member_signed_in? || admin_user_signed_in?
        = link_to "メッセージ", conversations_path
      - if webmaster?
        = link_to "運営管理トップ", webmaster_path
        = link_to "口コミ管理", super_admin_reviews_path
        = button_to "運営ログアウト", destroy_webmaster_session_path, method: :delete
      - elsif admin_user_signed_in? && current_admin_user.users.any?
        = link_to "マイページ", "/users/#{current_admin_user.users.first.id}/mypage"
      - elsif member_signed_in?
        = link_to "マイページ", member_path(current_member)
        = link_to "サークルを登録", new_admin_user_registration_path
      - elsif exhibition_group_signed_in?
        = link_to "マイページ", exhibitor_mypage_path
        = link_to "サークルを登録", new_admin_user_registration_path
      - elsif admin_user_signed_in?
        = link_to "サークルを登録", new_user_path
      - else
        = render "layouts/account_access", in_menu: true
    .mobile-menu-panel__group
      %strong サポート
      = link_to "よくある質問", faq_path
      = link_to "運営に問い合わせ", "https://x.com/circlebook03", target: "_blank", rel: "noopener noreferrer"
