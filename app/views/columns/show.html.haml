- set_meta_tags title: @column.title, description: (@column.description.presence || strip_tags(@column.text.to_s).truncate(150))
.main.column-page
  .container
    - if @preview
      .column-preview-notice
        %p= @column.published? ? '運営プレビュー：この記事は公開中です。' : '運営プレビュー：下書きのため一般には公開されません。'
        = link_to '記事の編集に戻る', edit_column_path(@column)
    = render 'article'
