- if respond_to?(:column_meta_tags)
  - set_meta_tags column_meta_tags(@column)
- else
  - set_meta_tags title: @column.title, description: (@column.description.presence || strip_tags(@column.text.to_s).truncate(150))
  - if @column.image.identifier.present?
    - set_meta_tags og: { image: @column.image.url }, twitter: { image: @column.image.url, card: 'summary_large_image' }
.main.column-page
  .container
    - if @preview
      .column-preview-notice
        %p= @column.published? ? '運営プレビュー：この記事は公開中です。' : '運営プレビュー：下書きのため一般には公開されません。'
        = link_to '記事の編集に戻る', edit_column_path(@column)
    = render 'article'
