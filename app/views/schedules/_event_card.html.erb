<%= link_to user_schedule_path(schedule.user_id, schedule.id), class: 'event-results__card' do %>
  <div class="event-results__card-top"><span><%= user.event&.name %></span><span class="event-results__status status-<%= status[:key] %>"><%= status[:label] %></span></div>
  <div class="event-results__body">
    <div class="event-results__text">
      <%= content_tag local_assigns.fetch(:heading_tag, :h3), schedule.title.presence || "#{user.event&.name}の活動" %>
      <p class="event-results__time"><%= lucide_icon 'clock' %><span><% if local_assigns[:show_date] %><%= calendar_schedule_date(Date.iso8601(schedule.day)) %> <br class="event-results__date-break"><% end %><%= calendar_schedule_time(schedule) %></span></p>
      <p class="event-results__location"><%= lucide_icon 'map-pin' %><%= [user.prefecture&.name, schedule.venue.presence].compact.join('・') %></p>
      <% if schedule.has_attribute?(:cost) && schedule.cost.present? %><p><%= lucide_icon 'banknote' %>参加費：<%= schedule.cost %></p><% end %>
    </div>
    <%= image_tag schedule_image_source(schedule, user: user), alt: '', width: 76, height: 76, loading: local_assigns[:eager] ? 'eager' : 'lazy', class: 'event-results__image' %>
  </div>
  <div class="event-results__card-bottom">
    <span class="event-results__capacity"><% if local_assigns[:accepted_count].to_i.positive? %>参加人数：<%= accepted_count %><%= "/#{schedule.recruitment_numbers}" if schedule.recruitment_numbers.to_i.positive? %>名<% elsif schedule.recruitment_numbers.to_i.positive? %>募集人数 <%= schedule.recruitment_numbers %>名<% else %>詳細で参加条件を確認<% end %></span>
    <span>詳細を見る <%= lucide_icon 'chevron-right' %></span>
  </div>
<% end %>
