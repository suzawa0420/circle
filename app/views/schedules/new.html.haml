- set_meta_tags noindex: true
.main.users-index
  .container
    .users-index-item.schedule_wrap
      %h1{ class: mobile_circle_switcher? ? "management-heading" : "top_title" } スケジュールの新規追加
      = render "users/parts/user_switching", user: @user
      - unless mobile_circle_switcher?
        = render "/users/parts/user_name", user: @user
      - if @copy_schedules.present?
        .schedule_copy_wrap
          .schedule_copy_txt
            = lucide_icon "copy"
            過去のスケジュールから複製する
          = form_tag new_user_schedule_path(@user), method: :get do
            %select{name: "copy", required: true, "aria-label" => "コピーするスケジュール"}
              %option{value: ""} コピーするスケジュールを選択する
              - @copy_schedules.each do |schedule|
                %option{value: schedule.id, selected: @copy_schedule&.id == schedule.id}
                  = Time.parse(schedule.day).strftime("%-m月%-d日(#{%w(日 月 火 水 木 金 土)[Time.parse(schedule.day).wday]})")
                  - if schedule.time_s.present?
                    = schedule.time_s.strftime('%-H:%M')
                    \-#{schedule.time_e.strftime('%-H:%M') if schedule.time_e.present?}
                  - if schedule.member_venue.present?
                    ＠#{schedule.member_venue}
                  - else
                    ＠#{schedule.venue}
            .schedule_copy_actions
              = button_tag "同じ内容でコピー", name: "copy_mode", value: "same", class: "btn btn-default"
              = button_tag "1週間後に同じ内容で作成", name: "copy_mode", value: "next_week", class: "btn btn-primary"
      = render "/schedules/form"
