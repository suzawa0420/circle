<div class="user_main event-management"><div class="container"><div class="em-shell">
  <%= render 'schedules/management_header', title: '出欠管理', back_path: manage_user_schedule_path(@user, @schedule), back_label: 'イベント管理へ' %>
  <nav class="em-tabs" aria-label="出欠の表示"><span aria-current="page">イベント別</span><% if @user.unique_id.present? %><%= link_to '全日程', attendances_path(@user.unique_id, archive: (@schedule.day < Date.current.iso8601 ? '1' : nil)) %><% end %></nav>
  <section class="em-card"><h2><%= @schedule.title %></h2><p class="em-muted"><%= calendar_schedule_date(Date.iso8601(@schedule.day)) %> <%= calendar_schedule_time(@schedule) %></p><div class="em-count"><span>参加 <strong><%= @management.count(@schedule, 1) %></strong><%= @schedule.recruitment_numbers.to_i.positive? ? " / #{@schedule.recruitment_numbers}名" : '名' %></span><span>不参加 <%= @management.count(@schedule, 0) %> · 未回答 <%= @management.unanswered(@schedule) %></span></div></section>
  <nav class="em-tabs em-tabs--answers" aria-label="回答で絞り込み"><% { 'all' => 'すべて', 'yes' => '参加', 'no' => '不参加', 'unanswered' => '未回答' }.each do |key, label| %><%= link_to label, manage_attendance_user_schedule_path(@user, @schedule, answer: key), aria: { current: (@attendance_filter == key ? 'page' : nil) } %><% end %></nav>
  <section class="em-card"><h2>メンバーの回答</h2><% if @attendance_names.any? %><ul class="em-answer-list"><% @attendance_names.each do |name| %><% answer = @attendance_answers[name.id] %><li><div><% if @schedule.day >= Date.current.iso8601 && @user.unique_id.present? %><%= link_to name.name, edit_attendance_path(@user.unique_id, name), class: 'em-answer-name' %><% else %><strong><%= name.name %></strong><% end %><% if answer&.comment.present? %><p><%= answer.comment %></p><% end %></div><span class="em-status"><%= answer&.answer == 1 ? '参加' : answer&.answer == 0 ? '不参加' : '未回答' %></span></li><% end %></ul><%= paginate @attendance_names %><% else %><p class="em-muted">該当する回答はありません。</p><% end %></section>
  <p class="em-muted">未回答は、これまでにこのサークルで出欠登録した名前を対象にしています。<% if @schedule.day >= Date.current.iso8601 && @user.unique_id.present? %>名前を選ぶと回答を変更・追加できます。<% end %></p>
  <% if @user.unique_id.present? %><section class="em-card em-card--member"><h2>メンバーに出欠を確認する</h2><%= render 'schedules/management_copy_url', url: "https://circle-book.com#{attendances_path(@user.unique_id)}", label: 'メンバー用の出欠回答URL', button: '出欠回答URLをコピー' %><%= link_to 'メンバー用ページを確認', attendances_path(@user.unique_id), class: 'em-text-link' %></section><% end %>
</div></div></div>
