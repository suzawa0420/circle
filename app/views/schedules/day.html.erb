<main class="event-results">
  <div class="event-results__container">
    <header class="event-results__header">
      <p class="event-results__eyebrow">日付から、参加したい活動を見つけよう</p>
      <h1 class="event-results__heading"><%= event_listing_heading(@event_day_title) %></h1>
      <% if @relative_day %><p><%= @day %></p><% end %>
      <p>時間・場所・募集状況を見比べて、気になるイベントへ。</p>
    </header>
    <nav class="event-results__shortcuts" aria-label="期間からイベントを探す">
      <%= link_to '今日', event_listing_path(@filter_query, period: 'today'), aria: { current: action_name == 'today' ? 'page' : nil } %>
      <%= link_to '明日', event_listing_path(@filter_query, period: 'tomorrow'), aria: { current: action_name == 'tomorrow' ? 'page' : nil } %>
      <%= link_to '今週', event_listing_path(@filter_query, period: 'this_week'), aria: { current: action_name == 'this_week' ? 'page' : nil } %>
      <%= link_to '来週', event_listing_path(@filter_query, period: 'next_week'), aria: { current: action_name == 'next_week' ? 'page' : nil } %>
      <%= link_to '今後の開催予定', @event_hub_path %>
    </nav>
    <%= render 'schedules/event_date_strip', dates: (@event_end_date ? (@event_date..@event_end_date) : (@event_date - 2..@event_date + 2)), filter_query: @filter_query, selected_date: (@event_end_date ? nil : @event_date) %>
    <%= form_with url: @event_filter_form_path, method: :get, local: true, class: 'event-results__filters' do |form| %>
      <label>エリア<%= form.select :pref, options_from_collection_for_select(@prefectures, :kana, :name, @prefecture&.kana), include_blank: '全国' %></label>
      <label>ジャンル<%= form.select :event, options_from_collection_for_select(@events, :ruby, :name, @event&.ruby), include_blank: 'すべて' %></label>
      <label>並び順<%= form.select :sort, options_for_select([['おすすめ（日替わり）', '1'], ['新着順', '2'], ['開始時間順', '3']], params[:sort] || '1') %></label>
      <%= form.submit '絞り込む', name: nil %>
    <% end %>
    <div class="event-results__summary"><h2><strong><%= @result_count %></strong>件のイベント</h2><p><%= '開催日順・' if @event_end_date %>募集中を優先<% unless %w[2 3].include?(params[:sort]) %>・同じ条件では日替わり表示<% end %></p></div>
    <% affiliate_placement = @schedules.empty? ? 'event_search_empty' : 'event_search' %>
    <% affiliate_ad = affiliate_ad_for_event(@event, placement: affiliate_placement) %>
    <% if @schedules.empty? %>
      <div class="event-results__empty"><h2>この条件のイベントはまだありません</h2><p>別の日付やエリア・ジャンルでも探してみてください。</p><%= link_to '今日のイベントを見る', today_events_path %></div>
      <%= render 'layouts/ads/affiliate', ad: affiliate_ad, placement: affiliate_placement if affiliate_ad %>
    <% else %>
      <ul class="event-results__list">
        <% @schedules.each_with_index do |schedule, index| %>
          <% key, label = @day_listing.status(schedule) %>
          <li>
            <%= render 'schedules/event_card', schedule: schedule, user: schedule.user, status: { key: key, label: label }, eager: index.zero?, show_date: @event_end_date.present? %>
          </li>
          <% if affiliate_ad && affiliate_ad_insert_after?(index + 1, total: @schedules.size) %>
            <li class="affiliate-ad-slot"><%= render 'layouts/ads/affiliate', ad: affiliate_ad, placement: affiliate_placement %></li>
          <% end %>
        <% end %>
      </ul>
      <%= paginate @schedules %>
    <% end %>
    <p class="event-results__note">募集状況は変更されることがあります。参加条件・会場の詳細は各イベントでご確認ください。</p>
    <%= render 'schedules/event_discovery' %>
    <%= render 'shared/structured_data', data: event_listing_structured_data %>
  </div>
</main>
