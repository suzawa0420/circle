<dl class="em-facts">
  <div><dt>日時</dt><dd><%= Date.iso8601(schedule.day).year %>年<%= calendar_schedule_date(Date.iso8601(schedule.day)) %> <%= calendar_schedule_time(schedule) %></dd></div>
  <div><dt>活動エリア</dt><dd><%= schedule.venue %></dd></div>
  <div><dt>参加費</dt><dd><%= schedule.cost.presence || '未設定' %></dd></div>
  <div><dt>募集人数</dt><dd><%= schedule.recruitment_numbers.nil? ? '未設定' : schedule.recruitment_numbers.zero? ? '制限なし' : "#{schedule.recruitment_numbers}名" %></dd></div>
  <% if schedule.member_venue.present? || schedule.venue_address.present? %><div class="em-facts-private"><dt><%= lucide_icon 'lock-keyhole' %>メンバー限定</dt><dd><%= schedule.member_venue %><% if schedule.venue_address.present? %><br><%= schedule.venue_address %><% end %></dd></div><% end %>
</dl>
