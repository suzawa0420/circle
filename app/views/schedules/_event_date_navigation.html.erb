<% compact = local_assigns.fetch(:compact, false) %>
<% unless compact %>
  <nav class="event-results__shortcuts event-results__shortcuts--periods" aria-label="期間からイベントを探す">
    <% [['今日', 'today'], ['明日', 'tomorrow'], ['今週', 'this_week'], ['来週', 'next_week']].each do |label, period| %>
      <%= link_to event_listing_path(filter_query, period: period), aria: { label: "#{label}のイベント" } do %><%= label %><span class="event-results__shortcut-suffix">のイベント</span><% end %>
    <% end %>
  </nav>
<% end %>
<%= render 'schedules/event_date_strip', dates: (date..date + 11), filter_query: filter_query %>
