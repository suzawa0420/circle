<% count = @management.count(@schedule, 1) %>
<% status = public_schedule_status(@schedule, accepted_count: count) %>
<div class="user_main event-management"><div class="container"><div class="em-shell">
  <%= render 'schedules/management_header', title: @schedule.title.presence || 'イベント管理', back_path: user_schedules_path(@user) %>
  <% if flash[:created_schedule_id].to_s == @schedule.id.to_s %><div class="em-notice" role="status"><%= lucide_icon 'calendar-check' %><div><strong>イベントを作成しました</strong><p>続けてメンバーへの共有や、次回の複製ができます。</p></div></div><% end %>
  <section class="em-card"><div class="em-row em-between"><h2>イベントの概要</h2><span class="em-status status-<%= status[:key] %>"><%= status[:label] %></span></div><%= render 'schedules/management_facts', schedule: @schedule %></section>
  <section class="em-card"><div class="em-row em-between"><h2>出欠状況</h2><span>参加 <strong><%= count %></strong><%= @schedule.recruitment_numbers.to_i.positive? ? " / #{@schedule.recruitment_numbers}名" : '名' %></span></div><p class="em-muted">不参加 <%= @management.count(@schedule, 0) %>名 · 未回答 <%= @management.unanswered(@schedule) %>名</p><%= link_to '出欠を確認する', manage_attendance_user_schedule_path(@user, @schedule), class: 'em-button em-button--primary em-button--full' %></section>
  <div class="em-grid"><%= link_to edit_user_schedule_path(@user, @schedule), class: 'em-button' do %><%= lucide_icon 'square-pen' %>編集する<% end %><%= link_to duplicate_user_schedule_path(@user, @schedule), class: 'em-button' do %><%= lucide_icon 'copy' %>複製する<% end %></div>
  <section class="em-section" id="event-share"><h2>参加者に案内する</h2><p class="em-muted">相手に合わせて、共有するページを選びます。</p>
    <% if @user.publicly_visible? %><section class="em-card"><p class="em-eyebrow">一般公開 / 新しく参加する人向け</p><h3>イベントを知らせる</h3><p class="em-muted">日時・活動エリア・参加費・活動内容を案内します。</p><%= link_to '一般公開ページを確認', user_schedule_path(@user, @schedule), class: 'em-button em-button--full' %><%= render 'schedules/management_copy_url', url: schedule_share_url(@schedule), label: 'イベントの公開URL', button: 'イベントURLをコピー' %><%= render 'schedules/share', schedule: @schedule, owner: true, created: false %></section>
    <% else %><p class="em-note">サークルが一般公開されていないため、メンバー限定URLから案内してください。</p><% end %>
    <% if @user.unique_id.present? %><section class="em-card em-card--member"><p class="em-eyebrow"><%= lucide_icon 'lock-keyhole' %>限定URL / 既存メンバー向け</p><h3>出欠を回答してもらう</h3><p class="em-muted">登録なしで回答できます。詳しい開催場所も表示されます。</p><%= link_to 'メンバー用ページを確認', attendances_path(@user.unique_id), class: 'em-button em-button--full' %><%= render 'schedules/management_copy_url', url: "https://circle-book.com#{attendances_path(@user.unique_id)}", label: 'メンバー用の出欠回答URL', button: '出欠回答URLをコピー' %><p class="em-muted">限定URLはメンバーにのみ共有してください。</p></section><% else %><p class="em-note">メンバー用の限定URLは、<%= link_to 'マイページ', "/users/#{@user.id}/mypage" %>で確認できます。</p><% end %>
  </section>
  <details class="em-card em-disclosure"><summary>活動内容を確認</summary><div class="em-disclosure-body em-rich-text"><%= sanitize @schedule.note, tags: %w[p a br strong em ul ol li div blockquote], attributes: %w[href] %></div></details>
  <% preparation_guides = flash[:created_schedule_id].to_s == @schedule.id.to_s && @user.publicly_visible? ? column_related_guides(event: @user.event, audience: 'organizer') : [] %>
  <% if preparation_guides.any? %><details class="em-card em-disclosure em-preparation"><summary>開催までの準備に役立つガイド</summary><div class="em-disclosure-body"><%= render 'columns/related_guides', event: @user.event, audience: 'organizer', heading: '開催までの準備', guides: preparation_guides %></div></details><% end %>
  <div class="em-section"><%= link_to 'このイベントを削除', confirm_delete_user_schedule_path(@user, @schedule), class: 'em-text-link em-danger' %></div>
</div></div></div>
