- title = "記事の写真 #{position + 1}"
- preview_url = local_assigns[:preview_url] || photo_url
= link_to photo_url, class: 'cb-blog-photo-gallery__link', aria: { label: "#{title}を拡大", haspopup: 'dialog', controls: dialog_id }, data: { circle_gallery_open: true, circle_gallery_kind: 'image', circle_gallery_title: title, circle_gallery_position: position } do
  = image_tag preview_url, class: 'cb-destination-blog__photo', alt: '', decoding: 'async', loading: position.zero? ? 'eager' : 'lazy'
  %span.cb-blog-photo-gallery__zoom{ aria: { hidden: 'true' } }
    = lucide_icon 'search'
