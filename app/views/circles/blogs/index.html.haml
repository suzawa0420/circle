- set_meta_tags title: "#{@user.name}の活動ブログ｜#{@user.prefecture.name}の#{@user.event.txt}｜サークルブック", description: "#{@user.prefecture.name}で活動している#{@user.event.txt}、#{@user.name}の活動ブログ", og: { image: @user.ogp_img }, twitter: { card: 'summary_large_image'}
- breadcrumb :circle_blog_index, @user
= render 'shared/structured_data', data: blog_listing_structured_data(@blogs)

= render layout: 'circles/shared/public_tab', locals: { circle: @user, active_tab: :blogs } do
  %header.cb-circle-tab-heading
    %h1{ class: ("management-heading" if mobile_circle_switcher?) } 活動ブログ
    %p 写真とレポートで、活動の雰囲気を見てみる。
  = render "/users/parts/user_switching", user: @user, url_path: "blogs"

  - if @blogs.any?
    %section.cb-circle-blogs__list{ aria: { labelledby: "circle-blog-list-heading" } }
      %h2#circle-blog-list-heading.sr-only 記事一覧
      - @blogs.each do |blog|
        = render 'circles/blogs/public_card', blog: blog, circle: @user
  - else
    %p.cb-circle-tab-empty まだ活動ブログはありません。

  .ad_space
  - if @user.publicly_visible? && (affiliate_ad = affiliate_ad_for_event(@user.event, placement: 'circle_blogs'))
    = render 'layouts/ads/affiliate', ad: affiliate_ad, placement: 'circle_blogs'
  - else
    = render "/layouts/ad_square"
  .ad_space
  = paginate @blogs
