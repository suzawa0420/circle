- set_meta_tags title: "【#{@time.strftime("%Y")}年版】#{@prefecture.name}の社会人サークル・学生サークル一覧｜メンバー募集",description: circle_listing_description,keywords: "#{@prefecture.name},サークル,チーム,団体"
- breadcrumb :prefecture_show, @prefecture
= render "circles/markups/circles_list", users: @users

.main.users-index
  .container

    .e_header_wrap
      %img{:src => "/images/top.png", :alt => ""}/
      .link_txt
        %h1.e_header_title
          = "#{@prefecture.name}で活動している"
          %br
          = "メンバー募集中の"
          %br
          = "サークルやチーム"

    - if @users&.size.to_i != 0
      = render "/circles/commons/search_form", categories: @categories, prefectures: @prefectures, path: @path
      = render "/circles/commons/users_list", users: @users

    - else
      = render "/circles/commons/no_hit"

    = render "circles/commons/discovery"
