- set_meta_tags title: "【#{@time.strftime("%Y")}年版】#{@prefecture.name}#{@city.name}のサークルやチームの一覧｜メンバー募集サイト",description: circle_listing_description,keywords: "#{@prefecture.name},#{@city.name},サークル,チーム,団体"
- breadcrumb :prefecture_city_show, @prefecture, @city
= render "circles/markups/circles_list", users: @users

.main.users-index
  .container

    .e_header_wrap
      %img{:src => "/images/top.png", :alt => ""}/
      .link_txt
        %h1.e_header_title
          = "#{@prefecture.name}#{@city.name}で活動している"
          %br
          = "メンバー募集中の"
          %br
          = "サークルやチーム"

    - if @users&.size.to_i != 0
      = render "/circles/commons/search_form", categories: @categories, prefectures: @prefectures, path: @path
      = render "/circles/commons/users_list", users: @users

    - else
      = render "/circles/commons/no_hit"

    = render "circles/commons/discovery"
