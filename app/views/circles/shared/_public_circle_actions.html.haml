- manageable = can_manage_circle?(circle)
.cb-public-circle__action-panel
  %p.cb-public-circle__action-title 参加を検討する
  - if manageable
    = link_to "サークルを編集", edit_user_path(circle), class: "cb-public-circle__primary", data: { turbolinks: false }
  - elsif circle.switch == "募集中"
    = link_to circle_inquiry_path(circle), circle_inquiry_link_options(circle).merge(class: "cb-public-circle__primary cb-participant") do
      = lucide_icon "mail", **{ "aria-hidden" => "true" }
      %span このサークルにお問い合わせ
  - else
    %span.cb-public-circle__primary.is-disabled 募集終了
  .cb-public-circle__secondary
    %div{ id: "mobile-circle-bookmark-#{circle.id}" }
      = render "bookmarks/mobile_button", user: circle
    = link_to "https://twitter.com/share?#{ { url: url_for(only_path: false), text: circle.name }.to_query }", target: "_blank", rel: "noopener", class: "cb-public-circle__share" do
      = lucide_icon "share-2", **{ "aria-hidden" => "true" }
      %span 共有
