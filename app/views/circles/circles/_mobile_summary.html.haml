- active_tab = local_assigns.fetch(:active_tab, :details)
- owns_circle = admin_user_signed_in? && current_admin_user.id == @user.admin_user_id
.mobile-circle-summary__top
  = link_to "‹ サークル検索へ", circles_path, class: "mobile-circle-summary__back"
  %span サークル詳細
.mobile-circle-summary
  .mobile-circle-summary__identity
    - if @user.pic_profile.present?
      = image_tag @user.pic_profile.url, alt: "", class: "mobile-circle-summary__image"
    - else
      .mobile-circle-summary__image.mobile-circle-summary__image--empty{ "aria-hidden" => "true" }= @user.name.to_s.first
    .mobile-circle-summary__heading
      %h2= @user.name
      %p
        = @user.switch
        %span ・
        = @user.prefecture.name
        %span ・
        = @user.event.name
    .mobile-circle-summary__bookmark{ id: "mobile-circle-bookmark-#{@user.id}" }
      = render "bookmarks/mobile_button", user: @user
  %nav.mobile-circle-summary__tabs{ "aria-label" => "サークル内のページ" }
    = render "circles/circles/mobile_tab", path: circle_path(@user), label: "詳細", icon: "info", current: active_tab == :details, disabled: false
    = render "circles/circles/mobile_tab", path: user_schedules_path(@user), label: "活動日", icon: "calendar-days", current: active_tab == :schedules, disabled: !owns_circle && !@user.schedules.exists?
    = render "circles/circles/mobile_tab", path: user_reviews_path(@user), label: "口コミ", icon: "message-circle", current: active_tab == :reviews, disabled: !@user.reviews.exists?
    = render "circles/circles/mobile_tab", path: user_questions_path(@user), label: "Q&A", icon: "circle-help", current: active_tab == :questions, disabled: false
    = render "circles/circles/mobile_tab", path: circle_blogs_path(@user), label: "ブログ", icon: "book-open", current: active_tab == :blogs, disabled: !owns_circle && !@user.blogs.publicly_visible.exists?
