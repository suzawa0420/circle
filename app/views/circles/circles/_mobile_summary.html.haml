- active_tab = local_assigns.fetch(:active_tab, :details)
- if local_assigns.fetch(:show_back, true)
  .mobile-circle-summary__top
    = link_to "‹ サークル検索へ", circles_path, class: "mobile-circle-summary__back", data: { circle_search_back: @user.id }
    %span サークル詳細
.mobile-circle-summary
  .mobile-circle-summary__identity
    = link_to circle_path(@user), class: "mobile-circle-summary__profile", target: "_blank", rel: "noopener", "aria-label" => "#{@user.name}の詳細を別タブで開く" do
      - if @user.pic_profile.present?
        = image_tag(fast_public_page? ? circle_listing_image_url(@user, 'profile') : @user.pic_profile.url, alt: "", width: 48, height: 48, decoding: "async", class: "mobile-circle-summary__image")
      - else
        .mobile-circle-summary__image.mobile-circle-summary__image--empty{ "aria-hidden" => "true" }= @user.name.to_s.first
      .mobile-circle-summary__heading
        %h2{ title: @user.name }= @user.name
        %p
          = @user.switch
          %span ・
          = @user.prefecture.name
          %span ・
          = @user.event.name
    - if local_assigns.fetch(:show_bookmark, true)
      .mobile-circle-summary__bookmark{ id: "mobile-circle-bookmark-#{@user.id}" }
        = render "bookmarks/mobile_button", user: @user
    - if local_assigns.fetch(:show_sticky_actions, false)
      = render "circles/shared/public_circle_sticky_actions", circle: @user
  %nav.mobile-circle-summary__tabs{ "aria-label" => "サークル内のページ" }
    - circle_public_navigation_tabs(@user, active_tab).each do |path, label, key, icon|
      = render "circles/circles/mobile_tab", path: path, label: label, icon: icon, current: active_tab == key
