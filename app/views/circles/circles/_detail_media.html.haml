- images = %i[gallery_01 gallery_02 gallery_03 gallery_04].filter_map { |slot| @user.public_send(slot).presence }
- video_id = @user.youtube_video_id
- if images.present? || video_id
  - gallery_size = images.size + (video_id ? 1 : 0)
  %section.cb-detail-card.cb-detail-media{ data: { circle_gallery: true } }
    %h2 写真・動画
    .cb-circle-gallery__thumbnails
      - images.each_with_index do |image, index|
        - title = "活動写真 #{index + 1}"
        = link_to image.url, class: "cb-circle-gallery__thumbnail", aria: { label: "#{title}を拡大", haspopup: "dialog", controls: "circle-gallery-dialog" }, data: { circle_gallery_open: true, circle_gallery_kind: "image", circle_gallery_title: title } do
          = lazysizes_image_tag image.url, alt: "", class: "cb-circle-gallery__thumbnail-image"
      - if video_id
        = link_to "https://www.youtube.com/watch?v=#{video_id}", class: "cb-circle-gallery__thumbnail cb-circle-gallery__thumbnail--video", aria: { label: "サークルの紹介動画を再生", haspopup: "dialog", controls: "circle-gallery-dialog" }, data: { circle_gallery_open: true, circle_gallery_kind: "video", circle_gallery_title: "サークルの紹介動画", circle_gallery_video_id: video_id } do
          = image_tag "https://i.ytimg.com/vi/#{video_id}/hqdefault.jpg", alt: "", loading: "lazy", width: 480, height: 360, class: "cb-circle-gallery__thumbnail-image"
          %span.cb-circle-gallery__play{ aria: { hidden: "true" } }= lucide_icon "play"
    %dialog#circle-gallery-dialog.cb-circle-gallery__dialog{ aria: { labelledby: "circle-gallery-title" }, data: { circle_gallery_dialog: true } }
      .cb-circle-gallery__toolbar
        %h2#circle-gallery-title 写真・動画ギャラリー
        %button.cb-circle-gallery__control.cb-circle-gallery__close{ type: "button", autofocus: true, aria: { label: "閉じる" }, data: { circle_gallery_close: true } }
          = lucide_icon "x", **{ "aria-hidden" => "true" }
      .cb-circle-gallery__stage
        %div.cb-circle-gallery__media{ data: { circle_gallery_media: true } }
        - if gallery_size > 1
          %button.cb-circle-gallery__control.cb-circle-gallery__previous{ type: "button", aria: { label: "前の写真・動画" }, data: { circle_gallery_move: "-1" } }
            = lucide_icon "chevron-right", **{ "aria-hidden" => "true" }
          %button.cb-circle-gallery__control.cb-circle-gallery__next{ type: "button", aria: { label: "次の写真・動画" }, data: { circle_gallery_move: "1" } }
            = lucide_icon "chevron-right", **{ "aria-hidden" => "true" }
      %p.cb-circle-gallery__status{ role: "status", aria: { live: "polite", atomic: "true" }, data: { circle_gallery_status: true } }
      %a.cb-circle-gallery__fallback{ hidden: true, target: "_blank", rel: "noopener noreferrer", data: { circle_gallery_fallback: true } } YouTubeで見る
