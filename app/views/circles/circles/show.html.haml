- set_meta_tags title: "#{@user.name}｜#{@user.prefecture.name}の#{@user.event.txt}",description: "#{@user.prefecture.name}で活動している#{@user.event.txt}の【#{@user.name}】です！新しいメンバーを募集中！#{@user.recruitment}｜サークルブックは、クラブやチームメンバーを募集するSNSです！",keywords: "#{@user.event.name},#{@user.prefecture.name},サークル,チーム,募集",og: {title: "#{@user.name}｜#{@user.prefecture.name}で活動している#{@user.event.txt}｜サークルブック",description: "#{@user.prefecture.name}で活動している#{@user.event.txt}｜#{@user.name}", image: @user.ogp_img }
- breadcrumb :circle_show, @user

= render "users/parts/local_business_show", user: @user
.cb-public-circle.cb-detail-redesign.mobile-circle-page
  .cb-public-circle__shell
    = render "circles/shared/public_circle_back", circle: @user
    = render "detail_cover"
    - reviews_count = @user.reviews.count
    .cb-detail-identity
      .cb-detail-avatar= render "detail_avatar"
      .cb-detail-identity__body
        %h1= @user.name
        - if reviews_count.positive?
          = link_to user_reviews_path(@user), class: "cb-detail-identity__rating" do
            = render "layouts/review_score", review_score: @user.review_score.to_f, reviews_count: reviews_count
        - if @user.user_time.present?
          %p.cb-detail-identity__updated 更新日：#{time_tag @user.user_time.to_date}
    .circle-header-sentinel{ "aria-hidden" => "true" }
    = render "mobile_summary", active_tab: :details, show_back: false, show_bookmark: false
    = render "detail_moderation"

    .cb-public-circle__grid.cb-detail-grid
      %aside.cb-public-circle__sidebar.cb-detail-sidebar{ aria: { label: "参加と基本情報" } }
        .cb-detail-action-panel
          %h2 参加を検討する
          .cb-detail-primary
            = render "mobile_contact"
          .circle-detail-cover__actions.cb-detail-actions
            .mobile-circle-summary__bookmark{ id: "mobile-circle-bookmark-#{@user.id}" }
              = render "bookmarks/mobile_button", user: @user
            - if @user.name.present? && @user.event.name.present? && @user.prefecture.name.present?
              - share_uri = "https://twitter.com/share?" + { url: request.url, text: "#{@user.name}\n\n##{@user.event.name} ##{@user.prefecture.name} #サークルブック" }.to_query
              = link_to share_uri, target: "_blank", rel: "noopener", class: "circle-detail-cover__action circle-detail-cover__action--share" do
                = lucide_icon "share-2"
                共有
            - if (webmaster? || admin_user_signed_in?) && can_manage_circle?(@user)
              = link_to "プロフィール編集", edit_user_path(@user), data: { turbolinks: false }, class: "circle-detail-cover__action circle-detail-cover__action--edit"
        = render "detail_facts"
      .cb-public-circle__main.cb-detail-main
        = render "conversations/no_reply_notice", user: @user
        = render "upcoming_activity"
        = render "detail_media"
        = render "circles/circles/member_composition", circle: @user
        - if @user.appeal.present? || @user.recruitment.present?
          %section.cb-detail-card.cb-detail-introduction
            %h2 サークル紹介
            - if @user.recruitment.present?
              %p.cb-detail-recruitment= @user.recruitment
            = render "detail_introduction"

        %section.cb-detail-card.cb-detail-review
          %h2 口コミ
          - if reviews_count.positive?
            = link_to user_reviews_path(@user), class: "cb-detail-identity__rating" do
              = render "layouts/review_score", review_score: @user.review_score.to_f, reviews_count: reviews_count
            .circle-readmore.circle-readmore--reviews{ data: { circle_readmore: true } }
              #circle-reviews-content.circle-readmore__content
                .circle-readmore__body
                  - circle_displayed_reviews(@user).each do |review|
                    = render "/reviews/review_comment", review: review
              %button.circle-readmore__button{ type: "button", hidden: true, "aria-expanded" => "false", "aria-controls" => "circle-reviews-content", "aria-label" => "口コミ・評価をもっと見る", data: { readmore_label: "口コミ・評価" } }
                %span{ data: { readmore_text: true } } もっと見る
                %span.circle-readmore__chevron{ "aria-hidden" => "true" }
            = link_to "口コミの一覧を見る", user_reviews_path(@user)
          - else
            %p 口コミがまだ投稿されていません。
            %p 主催者から返信を受けた方は、チャットから口コミを投稿できます。
            = link_to "口コミの一覧を見る", user_reviews_path(@user)

        - unless AccountBlock.exists?(ip_address: request.remote_ip) || @user.review_permit == false
          %section.cb-detail-card.cb-detail-questions{ aria: { label: "Q&A" } }
            = render "detail_questions"
        = render "related_content"
        = render "detail_organizer"
        = render "detail_links"
        .cb-detail-bottom-contact= render "mobile_contact"
        = render "similar_circles"
        = render "columns/related_guides", event: @user.event, audience: "participant", heading: "#{@user.event.name}に参加する前に、道具の準備"
        = render "/layouts/ad_square"
        .ad_space
