- recent_blogs = @user.blogs.publicly_visible.order(created_at: :desc).limit(3).to_a
- if recent_blogs.any?
  %section.cb-detail-card.cb-detail-blogs.cb-detail-card--nested-cards
    %h2 活動ブログ
    %ul.cb-blog-listing-excerpts
      - recent_blogs.first(2).each do |blog|
        %li
          = render "circles/blogs/public_card", blog: blog, circle: @user, summary: true
    = link_to "ブログの一覧を見る", circle_blogs_path(@user), class: "cb-detail-inline-link"
- if recent_blogs.size >= 3 || @users.size >= 3
  = render "/layouts/ad_square"
  .ad_space
