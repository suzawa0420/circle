- set_meta_tags title: circle_listing_title
- breadcrumb :circle_index
= render "circles/markups/circles_list", users: @users

.main.users-index
  .container

    %img.lazyload.imege_title{"data-src" => "/images/top.png"}/
    %h1.users-heading.circle-listing-heading= circle_listing_heading

    .users-txt
      - if admin_user_signed_in? && current_admin_user.first_user
        = link_to("活動日の登録", user_schedules_path(current_admin_user.first_user) )
        をすると
        %br/
        あなたの掲載順位が上がります！
      - else
        あなたにピッタリの
        %br/
        サークルやチーム、団体が見つかる！！

    = render "/circles/commons/search_form", categories: @categories, prefectures: @prefectures, path: @path
    = render "/circles/commons/users_list", users: @users
