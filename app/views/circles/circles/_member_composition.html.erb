<% ages = circle.member_age_percentages %>
<% male = circle.member_male_percentage %>
<% if ages.present? || !male.nil? %>
  <section class="cb-composition-display" aria-labelledby="member-composition-heading">
    <h2 id="member-composition-heading">メンバー構成</h2>
    <p class="cb-composition-caption">主催者による目安です。</p>
    <% if ages.present? %>
      <div class="cb-composition-group">
        <h3>年齢の割合</h3>
        <div class="cb-composition-ages">
          <div class="cb-composition-axis" aria-hidden="true"><span>100%</span><span>75%</span><span>50%</span><span>25%</span><span>0%</span></div>
          <ul class="cb-composition-bars">
            <% HasMemberComposition::BANDS.each do |band, label| %>
              <% value = ages.fetch(band) %>
              <li aria-label="<%= "#{label} #{value}%" %>">
                <div class="cb-composition-bar-track" aria-hidden="true">
                  <div class="cb-composition-bar-fill" style="--composition-ratio: <%= value.to_i %>%"></div>
                </div>
                <span class="cb-composition-band"><%= label %></span>
                <span class="cb-composition-percent"><%= value %>%</span>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>
    <% unless male.nil? %>
      <div class="cb-composition-group">
        <h3>男女比</h3>
        <div class="cb-composition-gender-bar" aria-hidden="true">
          <span class="cb-composition-gender-male" style="--composition-ratio: <%= male.to_i %>%"></span>
          <span class="cb-composition-gender-female" style="--composition-ratio: <%= 100 - male %>%"></span>
        </div>
        <ul class="cb-composition-gender-labels">
          <li>男性 <strong><%= male %>%</strong></li>
          <li>女性 <strong><%= 100 - male %>%</strong></li>
        </ul>
        <p class="cb-composition-caption">男性・女性として把握しているメンバー内の割合です。</p>
      </div>
    <% end %>
  </section>
<% end %>
