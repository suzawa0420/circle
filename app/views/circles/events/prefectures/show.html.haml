- if request.path == "/events/badminton/prefectures/tokyo" && request.query_string.empty?
  - title = "東京都のバドミントンサークル募集｜初心者・社会人も探せる"
  - description = "東京都で募集中のバドミントンサークルを検索。初心者・社会人・学生などの条件で絞り込み、活動場所・開催曜日・参加費を比べられます。"
- else
  - title = circle_listing_title
  - description = circle_listing_description
- set_meta_tags title: title, description: description, keywords: "#{@event.name},#{@prefecture.name},サークル,チーム", og: {image: default_activity_ogp_url(@event)}
- breadcrumb :event_prefecture_show, @event, @prefecture
= render "circles/markups/circles_list", users: @users

.main.users-index.directory-listing
  .container

    .e_header_wrap
      %img{:alt => "#{@event.name}", :src => "/images/events/#{@event.ruby}.jpg"}/
      .link_txt
        %h1.e_header_title.circle-listing-heading= circle_listing_heading

    - if @users&.size.to_i != 0
      = render "/circles/commons/search_form", categories: @categories, prefectures: @prefectures, path: @path
      = render "/circles/commons/users_list", users: @users

    - else
      = render "/circles/commons/no_hit"

    = render "circles/commons/discovery"
