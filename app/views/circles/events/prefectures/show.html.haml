- set_meta_tags title: circle_listing_title,description: circle_listing_description,keywords: "#{@event.name},#{@prefecture.name},サークル,チーム",og: {image:image_url("/images/events/#{@event.ruby}.jpg")}
- breadcrumb :event_prefecture_show, @event, @prefecture
= render "circles/markups/circles_list", users: @users

.main.users-index
  .container

    .e_header_wrap
      %img{:alt => "#{@event.name}", :src => "/images/events/#{@event.ruby}.jpg"}/
      .link_txt
        %h1.e_header_title= circle_listing_title

    - if @users&.size.to_i != 0
      = render "/circles/commons/search_form", categories: @categories, prefectures: @prefectures, path: @path
      = render "/circles/commons/users_list", users: @users

    - else
      = render "/circles/commons/no_hit"

    = render "circles/commons/discovery"
