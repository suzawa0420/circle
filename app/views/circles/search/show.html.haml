- set_meta_tags title: circle_listing_title
= render 'circles/markups/circles_list', users: @users if @users
- breadcrumb :circle_search_show, params[:q]

.main.users-index.directory-listing
  .container

    .e_header_wrap
      %img{:src => "/images/search.jpg"}/
      .link_txt
        %h1.e_header_title.circle-listing-heading= circle_listing_heading

    = render "/circles/commons/search_form", categories: @categories, prefectures: @prefectures, path: @path
    - if @users && @users.load.any?
      = render "/circles/commons/users_list", users: @users, listing_data: @listing_data
    - else
      = render "/circles/commons/no_hit"
