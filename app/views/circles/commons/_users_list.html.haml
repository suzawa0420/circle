- if admin_user_signed_in? && current_admin_user.first_user
  .post_message
    = link_to(circle_path(current_admin_user.first_user)) do
      = circle_avatar_tag current_admin_user.first_user, class:'post_image_icon'
    = link_to(new_circle_blog_path(current_admin_user.first_user)) do
      .post_link サークル活動をつぶやく！

- listing_data = local_assigns[:listing_data] || @listing_data || CircleListingData.new(users)
- users = listing_data.users
- show_picte_ad = picte_camera_event?(@event)
- affiliate_ad = affiliate_ad_for_event(@event, placement: 'search')
- cache [users, show_picte_ad, affiliate_ad_cache_key(affiliate_ad), 'seo-list-v14-affiliate-position', 'listing-card-v3-20261126'] do
  %ul.circle-results-grid
    - users.each.with_index(1) do |user, i|
      %li.user_item_wrap.cb-circle-list-card-shell
        = render "circles/commons/listing_card", circle: user, listing_data: listing_data, eager: i == 1, context: :search

      - if show_picte_ad && i == [2, users.size].min
        %li.picte-ad-slot
          = render 'layouts/ads/picte', placement: 'search'

      - if affiliate_ad && affiliate_ad_insert_after?(i, total: users.size)
        %li.affiliate-ad-slot
          = render 'layouts/ads/affiliate', ad: affiliate_ad, placement: 'search'

      - if !affiliate_ad && [5, 10, 15].include?(i)
        %li.list_ad
          = render "/layouts/ad_square"

= render "/layouts/ad_square"
= paginate users
