- filters = @landing_filters || params
.cb-search-city
  %label{ for: 'circle-search-city' } 市区町村
  - selected_prefecture = filters[:prefecture_id].presence || @prefecture&.id
  - cities = selected_prefecture.present? ? City.where(prefecture_id: selected_prefecture).order(:id) : City.none
  = select_tag :city_id, options_from_collection_for_select(cities, :id, :name, filters[:city_id].presence || @city&.id), include_blank: selected_prefecture.present? ? '指定なし（都道府県全域）' : '都道府県を選択してください', disabled: selected_prefecture.blank?, id: 'circle-search-city', class: 'cb-city-select', 'aria-describedby' => 'circle-search-city-status', data: { cities_url: circles_search_cities_path, prefecture_id: selected_prefecture }
  %p#circle-search-city-status.cb-detailed-search__hint{ 'data-city-status' => '', role: 'status' } 市区町村は1つ選択できます。
  %noscript
    %p.cb-detailed-search__hint 都道府県を変更した場合は、一度検索してから市区町村を選択してください。
