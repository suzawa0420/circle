- filters = @landing_filters || params
.search_wrap
  = form_tag circles_search_index_path, method: :get, enforce_utf8: false, class: 'cb-circle-search-form' do
    = hidden_field_tag :detailed, '1'
    = hidden_field_tag :sort, params[:sort] if params[:sort].present?
    - { category_id: @category&.id, city_id: @city&.id, tag_id: @tag&.id }.each do |key, value|
      = hidden_field_tag key, params[key].presence || value if params[key].present? || value
    .search_word
      .cb-search-keyword
        %input.search_area.change_font{ "aria-label" => "キーワードで検索", name: "q", placeholder: "例）バスケ　東京", type: "text", value: filters[:q] }
        .search_icon
          = submit_tag '検索', name: nil
      .search_word_announce ※複数の単語はスペースで区切ってください
    .search_select
      = select_tag :event_id, grouped_options_for_select(categories.map { |category| [category.name, category.events.map { |event| [event.name, event.id] }] }, filters[:event_id].presence || @event&.id), include_blank: 'サークル・チーム', 'aria-label' => '種目・カテゴリー'
      = select_tag :prefecture_id, grouped_options_for_select(prefecture_option_groups(prefectures).map { |region, items| [region, items.map { |prefecture| [prefecture.name, prefecture.id] }] }, filters[:prefecture_id].presence || @prefecture&.id), include_blank: '都道府県', 'aria-label' => '都道府県'
    = render "circles/commons/detailed_search"
  = render "circles/commons/active_filters"
  = render "schedules/select_date"

- unless controller.action_name == "kw"
  = render "shared/listing_sort"
