= render 'shared/structured_data', data: blog_listing_structured_data(blogs)
- if admin_user_signed_in? && current_admin_user.first_user
  .post_message
    = link_to(circle_path(current_admin_user.first_user)) do
      = circle_avatar_tag current_admin_user.first_user, class:'post_image_icon'
    = link_to(new_circle_blog_path(current_admin_user.first_user)) do
      .post_link サークル活動をつぶやく！

- affiliate_placement = blogs.empty? ? 'blog_search_empty' : 'blog_search'
- affiliate_ad = affiliate_ad_for_event(@event, placement: affiliate_placement)
.blog-results-grid.blog-directory-cards
  - cache [blogs, affiliate_ad_cache_key(affiliate_ad), 'blog-directory-shared-card-v3'] do
    - blogs.each.with_index(1) do |blog, i|
      = render 'circles/blogs/public_card', blog: blog, circle: blog.user, directory: true

      - if affiliate_ad && affiliate_ad_insert_after?(i, total: blogs.size)
        .affiliate-ad-slot
          = render 'layouts/ads/affiliate', ad: affiliate_ad, placement: 'blog_search'
      - elsif i == 5 && !affiliate_ad
        .list_ad
          = render "/layouts/ad_square"

- if blogs.empty?
  .no_hit_wrap.blog_no_hit
    = render "shared/empty_search", message: "該当するブログがありません"
    = link_to(root_path) do
      .no_hit_top トップページに戻る
    = link_to(new_admin_user_registration_path) do
      .no_hit_new 新しくサークルを登録する
- if affiliate_ad && blogs.empty?
  = render 'layouts/ads/affiliate', ad: affiliate_ad, placement: 'blog_search_empty'
- else
  = render "/layouts/ad_square"
= paginate blogs
