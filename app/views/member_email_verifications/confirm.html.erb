<main class="chat-shell"><div class="chat-card">
  <h1>メールアドレスの確認</h1>
  <% if @valid %>
    <%= form_with url: member_email_verification_path, method: :patch, local: true do |f| %>
      <%= hidden_field_tag :token, @token %>
      <%= f.submit 'メールアドレスを確認する', class: 'chat-button' %>
    <% end %>
  <% else %>
    <p>リンクが無効または期限切れです。確認メールを再送してください。</p>
    <%= link_to '確認メールの再送', member_email_verification_path %>
  <% end %>
</div></main>
