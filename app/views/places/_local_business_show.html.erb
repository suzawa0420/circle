<%
  business = {
    '@context' => 'http://schema.org/',
    '@type' => 'LocalBusiness',
    '@id' => request.path,
    'name' => place.name.to_s,
    'description' => "#{place.prefecture.name}#{place.city.name}にある#{place.name}のコート情報",
    'image' => ["/images/events/#{@event.ruby}.jpg"],
    'address' => {
      '@type' => 'PostalAddress',
      'addressCountry' => 'JP',
      'addressRegion' => place.prefecture.name.to_s,
      'addressLocality' => place.city.name.to_s,
      'streetAddress' => place.address.to_s
    }
  }
  business['telephone'] = place.tel if place.tel.present?
  business['priceRange'] = place.price if place.price.present?
  rating = review_aggregate_rating(place.average_score, review_count: place.public_place_reviews.count)
  business['aggregateRating'] = rating if rating
%>
<script type="application/ld+json"><%= raw json_escape(business.to_json) %></script>
