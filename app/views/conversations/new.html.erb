<main class="chat-shell cb-participant">
  <%= link_to @user.name, circle_path(@user) %>
  <h1>サークルに問い合わせる</h1>
  <%= render "conversations/no_reply_notice", user: @user %>
  <p>返信はこのサイトのメッセージで確認できます。初回の返信後、双方が対応について評価できます。</p>
  <% if [1, 2].include?(@user.admin_user.check) %>
    <aside class="chat-card" aria-label="参加前の注意">
      <img src="/images/mascot/squirrel-warning.png" alt="参加前の確認を呼びかけるリス" width="160" height="160" style="display:block;margin:0 auto;object-fit:contain">
      <%= render 'users/parts/admin_user_check', admin_user: @user.admin_user %>
    </aside>
  <% end %>
  <% if @inquiry_guidance.any? %>
    <section class="inquiry-guidance" aria-label="問い合わせ前の自動案内">
      <h2>メッセージを送る前に</h2>
      <p>サークルの活動予定・確認事項をご覧ください。</p>
      <% @inquiry_guidance.each do |body| %>
        <article class="chat-card inquiry-guidance__message"><strong class="message-role message-role--owner">サークルからの自動案内</strong><div class="chat-body"><%= automatic_message_body(body) %></div></article>
      <% end %>
      <% if CircleInquiryGuidance.template_for(@user).present? %>
        <button type="button" class="cb-button cb-button--secondary" data-inquiry-template-copy="<%= CircleInquiryGuidance.template_for(@user) %>">確認事項を回答欄に引用する</button>
      <% end %>
    </section>
  <% end %>
  <div class="chat-card">
    <%= form_with url: user_conversations_path(@user), scope: :message, local: true do |f| %>
      <%= f.label :body, '問い合わせ内容' %>
      <%= f.text_area :body, required: true, maxlength: 2000, rows: 8, placeholder: '参加希望の旨や、確認したいことをご記入ください。' %>
      <p>ニックネームと公開プロフィール・評価は主催者に表示されます。</p>
      <%= f.submit '問い合わせを送信', class: 'chat-button' %>
    <% end %>
  </div>
</main>
