<% person = role == 'owner' ? conversation.user : conversation.member %>
<% picture = role == 'owner' ? person.pic_profile : person.image_profile %>
<% name = role == 'owner' ? person.name : person.nickname %>
<span class="chat-avatar chat-avatar--<%= role %>" aria-hidden="true"><% if picture.present? %><%= image_tag picture.url, alt: '', loading: 'lazy' %><% elsif role != 'owner' %><%= image_tag default_user_avatar_path(person.gender), alt: '', loading: 'lazy' %><% else %><%= name.to_s.first.presence || '？' %><% end %></span>
