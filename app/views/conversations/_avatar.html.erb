<% person = conversation.person(role) %>
<% picture = person.is_a?(User) ? person.pic_profile : person.image_profile %>
<% name = person.is_a?(User) ? person.name : person.nickname %>
<span class="chat-avatar chat-avatar--<%= role %>" aria-hidden="true"><% if picture.present? %><%= image_tag picture.url, alt: '', loading: 'lazy' %><% elsif !person.is_a?(User) %><%= default_user_avatar_tag person.gender, alt: '', loading: 'lazy' %><% else %><%= name.to_s.first.presence || '？' %><% end %></span>
