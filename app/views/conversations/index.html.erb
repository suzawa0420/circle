<main class="chat-shell chat-inbox <%= "cb-participant" if member_signed_in? && !admin_user_signed_in? %>">
  <h1>メッセージ</h1>
  <p class="chat-muted"><%= member_signed_in? ? 'サークルへの問い合わせ・参加の相談' : '参加の相談・対戦や練習試合の相談' %></p>
  <% if @penalty_count.to_i.positive? || @penalty_only %>
    <aside class="chat-card chat-penalty-summary">
      <strong>未返信報告によるレベルの減少：<%= @penalty_count %>件（1件につき−30レベル）</strong>
      <p>やり取りを始めてから3日以上、初回返信がなく参加者から報告されたメッセージです。返信すると減点が解除されます。旧お問い合わせは対象外です。</p>
      <%= link_to(@penalty_only ? 'すべてのメッセージを見る' : '減点対象だけを見る', conversations_path(circle_id: params[:circle_id], penalty: @penalty_only ? nil : '1')) %>
    </aside>
  <% end %>
  <% if @conversations.empty? %>
    <div class="chat-card">
      <% if @penalty_only %>
        <p>現在、減点対象のメッセージはありません。</p>
      <% elsif member_signed_in? %>
        <p>メッセージはまだありません。気になるサークルに問い合わせると、ここでやり取りできます。</p>
        <%= link_to 'サークルを探す', circles_path %>
      <% else %>
        <p>参加希望者からのお問い合わせが届くと、ここに表示されます。主催者同士の練習試合の相談も確認できます。</p>
        <% circle = current_admin_user.users.first %>
        <%= link_to 'マイページへ戻る', circle ? "/users/#{circle.id}/mypage" : new_user_path %>
      <% end %>
    </div>
  <% end %>
  <div class="chat-talk-list">
    <% @conversations.each do |conversation| %>
      <% role = conversation.role_for(current_member, current_admin_user) %>
      <% incoming = role == 'member' ? 'owner' : 'member' %>
      <% latest = @latest_messages[conversation.id] %>
      <% unread = @unread_counts[role].fetch(conversation.id, 0) %>
      <% updated_at = conversation.inbox_updated_at.in_time_zone %>
      <article class="chat-talk-item" data-inbox-updated-at="<%= updated_at.iso8601(6) %>">
      <%= link_to conversation_path(conversation, anchor: ('evaluation' if conversation.review_prompt_due?(role))), class: "chat-talk #{'chat-talk--unread' if unread.positive?}" do %>
        <%= render 'avatar', conversation: conversation, role: incoming %>
        <span class="chat-talk__content">
          <strong class="chat-talk__name"><%= conversation.participant_name(incoming) %><%= "さん" if incoming == "member" && !conversation.practice_match? %></strong>
          <% if role == 'owner' && @penalty_ids.include?(conversation.id) %>
            <span class="chat-penalty-badge">未返信報告 −30レベル</span>
          <% end %>
          <% if conversation.review_prompt_due?(role) %><span class="chat-review-prompt-badge"><%= conversation.peer_review_waiting?(role) ? '口コミが届いています・あなたも投稿できます' : '感想を募集中' %></span><% end %>
          <% if @no_show_conversation_ids.include?(conversation.id) %><span class="chat-review-prompt-badge">欠席の申告・本人の説明を確認</span><% end %>
          <span class="chat-talk__preview"><%= 'あなた：' if latest&.sender_role == role %><%= latest&.preview_text %></span>
          <% if conversation.practice_match? %><span class="chat-talk__kind">対戦・練習試合</span><% end %>
        </span>
        <span class="chat-talk__meta"><time datetime="<%= updated_at.iso8601 %>"><%= updated_at.to_date == Date.current ? updated_at.strftime('%H:%M') : updated_at.strftime('%-m/%-d') %></time><% if unread.positive? %><span class="chat-badge" aria-label="未読<%= unread %>件"><%= unread %></span><% end %></span>
      <% end %>
      <% account_ids = ConversationNote.account_attributes(private_note_account(conversation)) %>
      <% note = @private_notes[[conversation.id, account_ids[:member_id], account_ids[:admin_user_id]]] %>
      <%= form_with url: private_note_conversation_path(conversation), scope: :note, method: :patch, local: true, class: 'chat-private-note', data: { private_note: true } do |f| %>
        <div class="chat-private-note__heading">
          <%= f.label :body, for: "private-note-#{conversation.public_id}" do %>
            <%= lucide_icon 'lock-keyhole', class: 'chat-private-note__lock', 'aria-hidden' => 'true' %><span>自分だけのメモ</span>
          <% end %>
          <span class="chat-private-note__state" role="status" aria-live="polite"><%= '保存済み' if note&.body.present? %></span>
          <button type="button" class="chat-private-note__retry" hidden>再試行</button>
        </div>
        <%= f.text_field :body, value: note&.body, id: "private-note-#{conversation.public_id}", placeholder: '○月○日、参加予定', maxlength: 300, autocomplete: 'off', class: 'chat-private-note__input' %>
        <noscript><%= f.submit 'メモを保存' %></noscript>
      <% end %>
      </article>
    <% end %>
  </div>
  <%= paginate @conversations %>
</main>
