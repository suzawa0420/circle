<% person = local_assigns[:person] || user %>
<% count = person.unanswered_report_count %>
<% if count.positive? %>
  <aside class="circle-reply-notice" aria-label="返信状況">
    <strong><%= count %>人から、返信がないとの報告があります</strong>
    <p>やり取りの中で3日以上返信がなく、相手が報告した人数です。返信すると人数から外れます。</p>
  </aside>
<% end %>
