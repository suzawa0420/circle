<% previous_date = nil %>
<% @messages.to_a.reverse_each do |message| %>
  <% if previous_date != message.created_at.to_date %><div class="chat-date"><time datetime="<%= message.created_at.to_date.iso8601 %>"><%= l(message.created_at.to_date) %></time></div><% end %>
  <% previous_date = message.created_at.to_date %>
  <% if message.automatic? %>
    <article class="chat-card inquiry-guidance__message"><strong class="message-role message-role--owner">サークルからの自動案内</strong><div class="chat-body"><%= automatic_message_body(message.body) %></div><% if @role == 'owner' && message.body.start_with?("主催者からのご案内・確認事項\n") %><%= link_to 'お問い合わせ内容を編集する', inquiry_settings_path(@conversation.user), class: 'cb-button cb-button--secondary inquiry-guidance__edit' %><% end %><time class="chat-message__meta" datetime="<%= message.created_at.iso8601 %>"><%= message.created_at.strftime('%H:%M') %></time></article>
  <% else %>
  <% mine = message.sender_role == @role %>
  <article class="chat-message chat-message--<%= message.sender_role %> <%= 'chat-message--mine' if mine %>">
    <% unless mine %><%= render 'avatar', conversation: @conversation, role: message.sender_role %><% end %>
    <div class="chat-message__content">
      <span class="message-role message-role--<%= message.sender_role %>"><%= message.sender_label %></span>
      <% unless mine %><strong class="chat-message__name"><%= message.sender_role == 'owner' ? @conversation.user.name : @conversation.member.nickname %></strong><% end %>
      <% unless message.delivered? %><p class="chat-moderation-note"><%= message.moderation_status == 'held' ? '運営が確認しています。相手にはまだ配信されていません。' : '運営が配信を見送りました。相手には配信されていません。' %></p><% end %>
      <div class="chat-message__row">
        <div class="chat-body"><%= render 'conversations/image', message: message %><%= chat_message_body(message.body) if message.body.present? %></div>
        <div class="chat-message__meta">
          <% if mine %><span class="chat-read-receipt" data-message-id="<%= message.id %>"><%= message.receipt_text(@conversation) %></span><% end %>
          <time datetime="<%= message.created_at.iso8601 %>" title="<%= message.created_at.strftime('%Y年%-m月%-d日 %H:%M') %>"><%= message.created_at.strftime('%H:%M') %></time>
        </div>
      </div>
      <% unless mine %>
        <details class="chat-message__report"><summary>通報</summary>
          <%= form_with url: report_conversation_path(@conversation), scope: :report, local: true do |f| %>
            <%= hidden_field_tag :message_id, message.id %>
            <%= f.label :reason, '通報理由', for: "message-report-#{message.id}" %>
            <%= f.text_area :reason, id: "message-report-#{message.id}", required: true, minlength: 6, maxlength: 2000 %>
            <%= f.submit '運営に通報する' %>
          <% end %>
        </details>
      <% end %>
    </div>
  </article>
  <% end %>
<% end %>
