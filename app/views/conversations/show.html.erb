<main class="chat-shell chat-thread <%= "cb-participant" if @role == "member" && !@conversation.practice_match? %>">
  <header class="chat-thread-heading">
    <%= link_to '‹ 一覧', conversations_path, class: 'chat-back', aria: { label: 'メッセージ一覧へ戻る' } %>
    <h1><%= @conversation.practice_match? ? '対戦・練習試合の相談' : 'メッセージ' %></h1>
    <a href="#chat-reply" class="chat-reply-link"><%= lucide_icon 'undo-2' %>返信欄へ</a>
  </header>
  <div id="chat-review-prompt"><%= render "review_prompt" if @review_prompt_due %></div>
  <%= render 'conversations/profiles', conversation: @conversation, viewer_role: @role %>
  <%= render "help_center/context_link", article: "message-notification", label: "返信・通知で困ったときはこちら" %>
  <% if @role == 'owner' && Conversation.reported_unanswered.exists?(@conversation.id) %>
    <aside class="chat-card chat-penalty-summary">
      <span class="chat-penalty-badge">未返信報告 −30ポイント</span>
      <p>このお問い合わせは初回返信がないと報告されています。メッセージを返信すると減点が解除されます。</p>
    </aside>
  <% end %>
  <% if !@conversation.practice_match? && @role == 'owner' %>
  <details class="chat-context"><summary>受付状況</summary>
  <div class="chat-card chat-person">
    <p id="chat-acceptance-status" class="cb-system-notice"><strong class="cb-system-notice__label">システム通知</strong><%= @conversation.accepted_at ? '受付済み' : (@role == 'owner' ? '返信すると受付済みになり、双方に評価権が発生します' : '主催者の返信をお待ちください') %></p>
  </div>
  </details>
  <% end %>
  <section aria-label="メッセージ履歴" class="chat-history">
    <%= paginate @messages %>
    <div id="chat-messages" class="chat-history" data-chat-jump-target="<%= "chat-message-#{@initial_jump[:message_id]}" if @initial_jump && !@review_prompt_due %>" data-chat-jump-alignment="<%= @initial_jump&.fetch(:alignment) %>" data-history-version="<%= history_version %>" data-latest-id="<%= @messages.first&.id || 0 %>" data-poll-url="<%= messages_conversation_path(@conversation) if @messages.current_page == 1 %>" data-accepted="<%= @conversation.accepted_at.present? %>">
      <%= render "messages" %>
    </div>
  </section>
  <div id="chat-latest" tabindex="-1"></div>
  <section id="chat-reply" class="chat-composer" aria-labelledby="chat-reply-title" tabindex="-1">
    <div class="chat-composer-heading">
      <span class="chat-composer-heading__icon"><%= lucide_icon 'square-pen' %></span>
      <div>
        <p class="chat-composer-recipient"><%= @conversation.participant_name(@role == 'owner' ? 'member' : 'owner') %><%= 'さん' if @role == 'owner' && !@conversation.practice_match? %>へ</p>
        <h2 id="chat-reply-title">メッセージを返信</h2>
      </div>
    </div>
    <% if @conversation.actor(@role).suspended? %>
      <p>利用停止中のため送信できません。過去の会話は確認できます。</p>
    <% elsif (@role == 'owner' || @conversation.practice_match?) && !current_admin_user.email_verified? %>
      <p>メッセージを送信するにはメールアドレスの確認が必要です。</p>
      <%= link_to 'メールアドレスを確認する', admin_user_email_verification_path %>
    <% elsif !@conversation.practice_match? && @role == 'member' && !current_member.japanese_profile? %>
      <p>自己紹介を日本語（ひらがな・カタカナを含む文章）に修正してから送信してください。</p>
      <%= link_to '自己紹介を修正する', edit_member_path(current_member) %>
    <% elsif @conversation.blocked? %>
      <p>ブロック中のため、双方とも送信できません。履歴の閲覧・通報は引き続き利用できます。</p>
    <% else %>
      <%= form_with url: message_conversation_path(@conversation), scope: :message, local: true, html: { class: "chat-compose-form", multipart: true } do |f| %>
        <% if @message_error %><p class="chat-upload-error" role="alert"><%= @message_error %> 写真は選び直してください。</p><% end %>
        <div class="chat-upload-preview" hidden><img alt="送信する写真"><span class="chat-upload-name"></span><button type="button" class="chat-upload-remove">取り消す</button></div>
        <p class="chat-upload-error" data-upload-error role="alert" hidden></p>
        <div class="chat-compose-row">
        <%= f.label :image, class: 'chat-image-picker', title: '写真を1枚選ぶ（10MBまで）' do %>
          <%= lucide_icon 'camera' %><span>写真を追加</span>
          <%= f.file_field :image, accept: 'image/jpeg,image/png,image/webp,image/heic,image/heif,.heic,.heif', class: 'chat-image-input', aria: { label: '写真を1枚選ぶ（10MBまで）' } %>
        <% end %>
        <%= f.label :body, 'メッセージ', class: 'chat-visually-hidden' %>
        <%= f.text_area :body, value: @draft_body, maxlength: 2000, rows: 4, placeholder: "メッセージを入力", class: "chat-compose-input" %>
        <%= f.submit '送信', class: 'chat-button', data: { disable_with: '送信中…' } %>
        </div>
      <% end %>
    <% end %>
  </section>
  <% if @conversation["#{@role}_blocked"] %>
    <div class="chat-card chat-controls">
      <p>ご自身の設定によりメッセージの送信を停止しています。</p>
      <%= button_to '自分のブロックを解除', block_conversation_path(@conversation), method: :delete %>
    </div>
  <% end %>
  <details class="chat-card chat-controls"><summary><span class="chat-section-label"><%= lucide_icon 'clock' %><span><%= @role == 'owner' && !@conversation.practice_match? ? '返信なし・連絡なしの欠席' : '返信がない場合' %></span></span></summary>
    <% if @role == 'owner' && !@conversation.practice_match? %>
      <div class="chat-report-choices" aria-label="報告の種類">
        <label><input type="radio" name="report-kind" value="reply" data-report-kind <%= 'checked' unless @no_show_draft&.errors&.any? %>>返信がない</label>
        <label><input type="radio" name="report-kind" value="absence" data-report-kind <%= 'checked' if @no_show_draft&.errors&.any? %>>連絡なしの欠席</label>
      </div>
      <div data-report-panel="absence"><%= render 'no_show_form' %></div>
    <% end %>
    <div data-report-panel="reply">
    <% if @conversation.practice_match? %>
      <p>やり取りでお困りの場合は運営へご相談ください。</p>
      <%= link_to '運営に相談する', new_support_request_path(category: 'message'), class: 'chat-support-link' %>
    <% elsif @conversation.blocked? %>
      <p>送信停止中の会話は、未返信として報告できません。</p>
    <% elsif @conversation.no_reply_reported_by?(@role) %>
      <p>返信がないことを報告済みです。相手が返信するとプロフィールの報告人数から外れます。</p>
    <% else %>
      <% reportable_at = @conversation.reply_reportable_at(@role) %>
      <p>やり取りから3日以上返信がない場合に報告できます。</p>
      <p class="chat-review-help">人数のみ表示。返信が届くと集計から外れます。</p>
      <% if reportable_at && Time.current >= reportable_at %>
        <%= button_to '返信がないことを報告する', no_reply_conversation_path(@conversation), id: 'chat-no-reply', class: 'chat-button', data: { confirm: '返信がないことを報告しますか？相手のプロフィールの報告人数に反映されます。' } %>
      <% elsif reportable_at %>
        <p class="chat-review-help">報告可能日時：<%= l(reportable_at, format: '%-m月%-d日 %H:%M') %></p>
        <button type="button" disabled>返信がないことを報告する</button>
      <% else %>
        <p class="chat-review-help">現在、返信待ちはありません。</p>
        <button type="button" disabled>返信がないことを報告する</button>
      <% end %>
    <% end %>
    </div>
  </details>
  <%= render 'no_show_reports' unless @conversation.practice_match? %>
  <% unless @conversation.practice_match? %>
  <details class="chat-card chat-evaluation" id="evaluation">
    <summary><span class="chat-section-label"><%= lucide_icon 'square-pen' %><span>口コミを投稿する</span></span></summary>
    <p>やり取りの感想を教えてください。</p>
    <% if @conversation.review_deadline %><p class="chat-review-deadline">投稿期限：<%= l(@conversation.review_deadline, format: '%-m月%-d日 %H:%M') %></p><% end %>
    <p class="chat-review-help">双方が投稿すると、その時点で公開されます。片方だけの場合は、最初の投稿から2週間後に公開されます。公開までは相手の内容は見えません。</p>
    <details class="chat-review-guidelines"><summary>公開・投稿のルール</summary><p class="chat-review-help">ニックネーム・サークル名も公開されます。連絡先などの個人情報は書かないでください。高評価や削除の強要、報復は禁止です。</p></details>
    <p id="chat-acceptance-notice" class="cb-system-notice" hidden><strong class="cb-system-notice__label">システム通知</strong>主催者から返信が届きました。<%= link_to "ページを更新して口コミを書く", conversation_path(@conversation, refresh: 1, anchor: "evaluation") %></p>
    <% if @conversation.actor(@role).suspended? %>
      <p>利用停止中のため口コミを投稿できません。</p>
    <% elsif !@conversation.accepted_at %>
      <p>主催者が最初に返信すると、口コミを投稿できるようになります。</p>
    <% elsif @conversation.reviews_published_at %>
      <p>投稿期間は終了しました。公開後は編集できません。削除後の再投稿もできません。</p>
    <% elsif @role == 'member' && @conversation.legacy_member_review %>
      <p>このサークルへの口コミは投稿済みです。評価は1人につき同じサークルに1件です。</p>
    <% elsif !@conversation.review_writable?(@role) %>
      <p>口コミの投稿にはメールアドレスの確認が必要です。</p>
      <%= link_to 'メールアドレスを確認する', @role == 'owner' ? admin_user_email_verification_path : member_email_verification_path %>
    <% else %>
      <%= form_with url: review_conversation_path(@conversation), method: :put, scope: :evaluation, local: true do |f| %>
        <fieldset class="chat-rating"><legend>やり取りはいかがでしたか？</legend>
          <div class="chat-rating-options">
            <% [[1, '良かった', 'smile'], [0, '残念だった', 'frown']].each do |score, label, expression| %>
              <%= f.label "score_#{score}", class: "chat-rating-option chat-rating-option--#{expression}" do %>
                <%= lucide_icon expression == "smile" ? "smile" : "frown" %>
                <span><%= label %></span>
                <%= f.radio_button :score, score, checked: (@own_review&.score == score), required: true %>
              <% end %>
            <% end %>
          </div>
        </fieldset>
        <% if @role == 'member' %>
          <div class="chat-attendance">
            <%= f.label :participated do %><%= f.check_box :participated, checked: @own_review&.participated? %><span>このサークルに参加しました</span><% end %>
          </div>
        <% end %>
        <%= f.label :comment, '感想（6〜2000文字）' %>
        <%= f.text_area :comment, value: @own_review&.comment, required: true, minlength: 6, maxlength: 2000, rows: 4 %>
        <%= f.submit (@own_review && !@own_review.deleted_at ? '口コミを更新する' : '口コミを投稿する'), class: 'chat-button' %>
      <% end %>
    <% end %>
    <% if @own_review && !@own_review.deleted_at %>
      <section class="chat-own-review">
        <h3>自分の口コミ</h3>
        <p class="chat-review-help"><%= @own_review.published_at ? '公開済みの口コミです。' : '公開時の表示イメージです。まだ相手には公開されていません。' %></p>
        <%= render 'review_preview', review: @own_review %>
      </section>
      <%= button_to '自分の口コミを削除', review_conversation_path(@conversation), method: :delete, data: { confirm: '自分の口コミを削除しますか？相手の口コミは残ります。公開後の削除は再投稿できません。' } %>
    <% elsif @own_review&.deleted_at %><p>自分の口コミは削除済みです。再投稿できません。</p><% end %>
    <% @public_reviews.each do |review| %>
      <% next if review.author_role == @role %>
      <div class="chat-own-review"><span class="review-sentiment <%= review.score == 1 ? 'review-sentiment--positive' : 'review-sentiment--negative' %>"><%= render 'member_profiles/expression', positive: review.score == 1 %><strong>相手の口コミ：<%= review.score == 1 ? '良かった' : '残念だった' %></strong></span><%= simple_format review.comment %></div>
      <details><summary>この口コミを通報する</summary>
        <%= form_with url: report_conversation_path(@conversation), scope: :report, local: true do |f| %>
          <%= hidden_field_tag :review_id, review.id %>
          <%= f.label :reason, '通報理由', for: "review-report-#{review.id}" %>
          <%= f.text_area :reason, id: "review-report-#{review.id}", required: true, minlength: 6, maxlength: 2000 %>
          <%= f.submit '運営に通報する' %>
        <% end %>
      </details>
    <% end %>
  </details>
<% end %>
</main>

<a href="#chat-reply" class="chat-reply-shortcut <%= 'chat-reply-shortcut--participant' if @role == 'member' && !@conversation.practice_match? %>"><%= lucide_icon 'undo-2' %><span>返信</span></a>
<%= render 'conversations/image_viewer' %>
