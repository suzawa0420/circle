.review_contents
  .review_l
    - if review.member.present? && review.member.image_profile.present?
      = lazysizes_image_tag review.member.image_profile.url, class: 'member_icon'
    - else
      - gender = review.member.present? ? review.member.gender : review.gender
      = default_user_avatar_tag gender, class: 'member_icon', alt: '', loading: 'lazy'
  .review_r
    .speech_title
      - if review.review == 1
        = lucide_icon "smile", class: "good"
      - elsif review.review == 0
        = lucide_icon "frown", class: "bad"
      - else
      - if review.member.present?
        = link_to review.member.nickname, member_profile_path(review.member)
        さん
        .btm_content
          - if review.member.gender == "1"
            男性
          - elsif review.member.gender == "2"
            女性
          - elsif review.member.gender == "0"
            その他
          - else
          = review.member.age_group
          %span.review_day
            ［#{review.created_at.strftime("%Y年%-m月%-d日")}］
      - else
        - if review.nickname.present?
          = review.nickname
          さん
        - else
          ゲストユーザー
        .btm_content
          - if review.gender == "1"
            男性
          - elsif review.gender == "2"
            女性
          - elsif review.gender == "0"
            その他
          - else
          = review.age
          %span.review_day
            ［#{review.created_at.strftime("%Y年%-m月%-d日")}］
      - if can_delete_review?(review)
        %span.review_delete
          = link_to "削除", user_review_path(review.user_id, review), method: :delete, data: {confirm: "口コミを削除しますか？公開後の削除は再投稿できません。"}
    .speech_bubble
      = simple_format review.comment
    - if review.conversation_review&.participated?
      %small 参加した感想（自己申告）
    - if review.conversation_review && admin_user_signed_in? && current_admin_user.id == review.user.admin_user_id
      %p= link_to "評価の確認・通報", conversation_path(review.conversation_review.conversation, anchor: 'evaluation')
.reset
