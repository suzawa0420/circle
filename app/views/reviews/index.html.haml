- set_meta_tags title: "#{@user.name}の口コミ・評価"
.user_main.users-index
  .container
    .users-index-item
      %h1.top_title 口コミ・評価
      = render "/users/parts/user_switching", user: @user, url_path: "reviews"
      = render "layouts/review_score", review_score: @user.review_score.to_f, reviews_count: @user.reviews.count
      .reset
      %hr/
      %p 口コミは、サイト内で問い合わせて主催者から返信を受けた方が投稿できます。
      - if @conversation
        %p= link_to "メッセージ・相互評価へ", conversation_path(@conversation, anchor: 'evaluation')
      - elsif !admin_user_signed_in?
        %p= link_to "このサークルに問い合わせる", new_user_conversation_path(@user)
      - if @reviews.empty?
        %p 口コミはまだありません。
      = render "/reviews/reviews_list", reviews: @reviews
      %hr/
      = render "/layouts/ad_square"
      .ad_space
