- set_meta_tags title: "#{@user.name}の口コミ・評価"
.user_main.users-index
  .container
    .users-index-item
      %h1{ class: mobile_circle_switcher? ? "management-heading" : "top_title" } 口コミ・評価
      = render "/users/parts/user_switching", user: @user, url_path: "reviews"
      = render "layouts/review_score", review_score: @user.review_score.to_f, reviews_count: @user.reviews.count
      .reset
      %hr/
      %p 口コミは、サイト内で問い合わせて主催者から返信を受けた方が投稿できます。
      - if can_manage_circle?(@user)
        %section#review-request.well
          %strong 参加者に口コミを依頼する
          %p 参加した方とのメッセージで、活動の感想を口コミに投稿してもらえるようお願いしましょう。参加者はメッセージ画面の「口コミを投稿する」から投稿できます。
          = link_to "メッセージを開く", conversations_path
      - if @conversation
        %p= link_to "メッセージ・相互評価へ", conversation_path(@conversation, anchor: 'evaluation')
      - elsif !admin_user_signed_in?
        %p= link_to "このサークルに問い合わせる", new_user_conversation_path(@user), circle_inquiry_link_options(@user)
      - if @reviews.empty?
        %p 口コミはまだありません。
      = render "/reviews/reviews_list", reviews: @reviews
      %hr/
      = render "/layouts/ad_square"
      .ad_space
