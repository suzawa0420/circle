- set_meta_tags title: "#{@user.name}の口コミ・評価"
= render 'shared/structured_data', data: circle_profile_structured_data(@user, reviews: @reviews.to_a)
= render layout: 'circles/shared/public_tab', locals: { circle: @user, active_tab: :reviews } do
  .cb-circle-reviews
    %header.cb-circle-tab-heading
      %h1{ class: ("management-heading" if mobile_circle_switcher?) } 口コミ・評価
      %p 参加前に、実際の感想を確認できます。
    = render 'users/parts/user_switching', user: @user, url_path: 'reviews'
    - if @reviews.any?
      - review_count = @reviews.size
      - review_score = @user.review_score.to_f
      - display_score = format('%.2f', review_score).sub(/0\z/, '')
      .cb-circle-reviews__summary{ role: "group", aria: { label: "総合評価：5点満点中#{display_score}、口コミ#{review_count}件" } }
        %strong.cb-circle-reviews__score= display_score
        .cb-circle-reviews__summary-details
          = render 'layouts/review_stars', review_score: review_score, reviews_count: review_count
          %span= "#{review_count}件の口コミ"
    %p.cb-circle-reviews__help 口コミは、サイト内で問い合わせて主催者から返信を受けた方が投稿できます。
    - if can_manage_circle?(@user)
      %section#review-request.cb-circle-reviews__notice
        %strong 参加者に口コミを依頼する
        %p 参加した方とのメッセージで、活動の感想を口コミに投稿してもらえるようお願いしましょう。参加者はメッセージ画面の「口コミを投稿する」から投稿できます。
        = link_to "メッセージを開く", conversations_path
    - if @conversation
      %p= link_to "メッセージ・相互評価へ", conversation_path(@conversation, anchor: 'evaluation')
    - if @reviews.empty?
      %p.cb-circle-reviews__notice 口コミはまだありません。
    - else
      .cb-circle-reviews__list
        = render partial: 'reviews/public_card', collection: @reviews, as: :review
    = render 'layouts/ad_square'
    .ad_space
