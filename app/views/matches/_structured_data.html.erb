<% data = if local_assigns[:matching]
  match_page_structured_data(matching)&.merge('@context' => 'https://schema.org')
else
  entries = @matches.filter_map do |match|
    item = match_page_structured_data(match)
    { 'item' => item } if item
  end
  structured_collection(entries, offset: @matches.offset_value, name: match_listing_heading)
end %>
<%= render 'shared/structured_data', data: data %>
