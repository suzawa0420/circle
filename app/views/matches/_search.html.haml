.search_wrap
  .search_select
    - if @path.is('matches#index')
      %select{"aria-label" => "種目・カテゴリー", :name => "event_select", :onchange => "location.href=value;"}
        %option{:value => "#"} サークル・団体
        - @events.each do |event|
          %option{:value => "/match/#{event.ruby}"}= event.name
      %select{"aria-label" => "都道府県", :name => "prefecture_select", :onchange => "location.href=value;"}
        %option{:value => "#"} 都道府県
        - prefecture_option_groups(@prefectures).each do |region, region_prefectures|
          %optgroup{ label: region }
            - region_prefectures.each do |prefecture|
              - if prefecture.id != 50
                %option{:value => "/match/prefectures/#{prefecture.kana}"}= prefecture.name
      .search_icon
        = lucide_icon "search"
    - elsif @path.is('matches#event_prefecture')
      %select{"aria-label" => "種目・カテゴリー", :name => "event_select", :onchange => "location.href=value;"}
        %option{:value => "#"}= @event.name
        - @events.each do |event|
          - if event.ruby != @event.ruby
            %option{:value => "/match/#{event.ruby}"}= event.name
      %select{"aria-label" => "都道府県", :name => "prefecture_select", :onchange => "location.href=value;"}
        %option{:value => "#"}= @prefecture.name
        - prefecture_option_groups(@prefectures).each do |region, region_prefectures|
          %optgroup{ label: region }
            - region_prefectures.each do |prefecture|
              - if prefecture.id != 50
                - if prefecture.kana != @prefecture.kana
                  %option{:value => "/match/#{@event.ruby}/#{prefecture.kana}"}= prefecture.name
      .search_icon
        = lucide_icon "search"
    - elsif  @path.is('matches#event')
      %select{"aria-label" => "種目・カテゴリー", :name => "event_select", :onchange => "location.href=value;"}
        %option{:value => "#"}= @event.name
        - @events.each do |event|
          - if event.ruby != @event.ruby
            %option{:value => "/match/#{event.ruby}"}= event.name
      %select{"aria-label" => "都道府県", :name => "prefecture_select", :onchange => "location.href=value;"}
        %option{:value => "#"} 都道府県
        - prefecture_option_groups(@prefectures).each do |region, region_prefectures|
          %optgroup{ label: region }
            - region_prefectures.each do |prefecture|
              - if prefecture.id != 50
                %option{:value => "/match/#{@event.ruby}/#{prefecture.kana}"}= prefecture.name
      .search_icon
        = lucide_icon "search"
    - elsif @path.is('matches#prefecture')
      %select{"aria-label" => "種目・カテゴリー", :name => "event_select", :onchange => "location.href=value;"}
        %option{:value => "#"} サークル
        - @events.each do |event|
          %option{:value => "/match/#{event.ruby}/#{@prefecture.kana}"}= event.name
      %select{"aria-label" => "都道府県", :name => "prefecture_select", :onchange => "location.href=value;"}
        %option{:value => "#"}= @prefecture.name
        - prefecture_option_groups(@prefectures).each do |region, region_prefectures|
          %optgroup{ label: region }
            - region_prefectures.each do |prefecture|
              - if prefecture.id != 50
                - if prefecture.kana != @prefecture.kana
                  %option{:value => "/match/prefectures/#{prefecture.kana}"}= prefecture.name
      .search_icon
        = lucide_icon "search"
    - else
