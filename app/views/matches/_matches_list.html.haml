- if @matches.empty?
  .match-directory__empty
    = lucide_icon 'search'
    %h2 この条件の対戦相手募集はまだありません
    %p 種目や活動エリアを変えて、もう一度探してみてください。
    = link_to '全国の対戦相手募集を見る', matches_path
- else
  .match-directory__list
    - @matches.each.with_index(1) do |matching, i|
      = render 'matches/card', matching: matching
      - if i == 5
        .match-directory__ad= render '/layouts/ad_square'
  = paginate @matches
.match-directory__ad= render '/layouts/ad_square'
