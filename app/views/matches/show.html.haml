- set_meta_tags title: "#{@match.user.name}｜#{@match.user.prefecture.name}の#{@match.user.event.txt}",description: "#{@match.user.prefecture.name}で活動している#{@match.user.event.name}サークル【#{@match.user.name}】です！新しい対戦相手を募集中！#{@match.comment}｜サークルブックは、サークルやチームの対戦相手を募集するサイトです！",keywords: "#{@match.user.event.name},#{@match.user.prefecture.name},サークル,チーム,対戦相手募集",og: {title: "#{@match.user.name}｜サークルブック",description: "#{@match.user.prefecture.name}で活動している#{@match.user.event.name}サークル｜#{@match.user.name}",image: @match.user.pic_profile.url},twitter: { card: 'summary'}
= render "matches/structured_data", matching: @match
%main.match-directory.match-directory--detail
  .match-directory__container
    = link_to matches_path, class: 'match-directory__back' do
      = lucide_icon 'undo-2'
      対戦相手募集の一覧へ
    %section.match-directory__profile
      .match-directory__card-top
        %p.match-directory__eyebrow 対戦相手・練習試合の募集
        %span.match-directory__status{ class: @match.recruit == '募集中' ? nil : 'is-closed' }= @match.recruit.presence || '募集状況未設定'
      .match-directory__identity
        = match_avatar @user, detail: true
        %div
          %h1= @user.name
          %p.match-directory__location
            = lucide_icon 'map-pin'
            = @event.name
            ·
            = @prefecture.name
            - if @sub_prefecture
              ・#{@sub_prefecture.name}
      = render 'matches/updated_dates', matching: @match
      - if can_manage_circle?(@user)
        = link_to '募集プロフィールを編集', edit_match_path(@match), class: 'match-directory__edit'
    .match-directory__detail-grid
      %div
        %section.match-directory__section
          %h2 チーム・募集条件
          %dl.match-directory__conditions
            - { '種目' => @event.name, '活動場所' => [@prefecture.name, @sub_prefecture&.name].compact.join('・'), '年齢層' => @match.age_group, 'メンバー' => @match.member, 'レベル' => @match.level }.each do |label, value|
              %div
                %dt= label
                %dd= value.presence || '未設定'
        %section.match-directory__section
          %h2 募集内容
          - if @match.comment.present?
            .match-directory__description= sanitize(Rinku.auto_link(simple_format(@match.comment)))
          - else
            %p.match-directory__muted 詳しい条件は、チームへお問い合わせください。
        %section.match-directory__section
          %h2 サークルについて
          = link_to circle_path(@user), class: 'match-directory__circle-link' do
            = lucide_icon 'users'
            サークルの紹介・メンバー募集を見る
            = lucide_icon 'chevron-right'
          - if @user.web.present? || @user.twitter.present? || @user.instagram.present?
            .match-directory__social
              - if @user.web.present?
                = link_to @user.web do
                  = lucide_icon 'link'
                  公式サイト
              - if @user.twitter.present?
                = link_to "https://twitter.com/#{@user.twitter}" do
                  = lucide_icon 'share-2'
                  X（Twitter）
              - if @user.instagram.present?
                = link_to "https://www.instagram.com/#{@user.instagram}" do
                  = lucide_icon 'camera'
                  Instagram
      %aside.match-directory__aside
        = render 'matches/contact'
    .match-directory__ad= render '/layouts/ad_square'
    - related_matches = @matches.to_a
    - if related_matches.any?
      %section.match-directory__related
        %h2 同じエリア・種目の対戦相手募集
        %p #{@prefecture.name}の#{@event.name}で、ほかのチームも探してみましょう。
        .match-directory__list
          - related_matches.each do |matching|
            = render 'matches/card', matching: matching, related: true
        = link_to "#{@prefecture.name}の#{@event.name}をもっと見る", "/match/#{@event.ruby}/#{@prefecture.kana}", class: 'match-directory__back'
