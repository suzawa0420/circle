<% set_meta_tags title: "#{@user.name}の質問コーナー",
  og: {
    title: "登録不要！匿名で「#{@user.name}」に質問ができます！",
    description: "",
    image: image_url('/images/qa_top.jpg')
  },
  twitter: { card: 'summary_large_image' }
%>

<%= render layout: 'circles/shared/public_tab', locals: { circle: @user, active_tab: :questions } do %>
  <header class="cb-circle-tab-heading">
    <h1 class="<%= "management-heading" if mobile_circle_switcher? %>">Q&amp;A</h1>
    <p>参加前に気になることを、公開の質問で確認できます。</p>
  </header>
  <%= render "/users/parts/user_switching", user: @user, url_path: "questions" %>

  <% can_ask = !AccountBlock.exists?(ip_address: request.remote_ip) && @user.review_permit != false %>
  <% owner = admin_user_signed_in? && @user.admin_user_id == current_admin_user.id %>
  <% if can_ask %>
    <section class="cb-circle-questions__ask" aria-labelledby="circle-ask-heading">
      <h2 id="circle-ask-heading">サークルに質問する</h2>
      <p id="circle-question-rules">匿名で投稿できます。個人情報は書かないでください。</p>
      <%= form_for [@user, @question] do |f| %>
        <%= render 'layouts/error_messages', model: f.object %>
        <%= f.text_area :content, id: "input-text", rows: 3, placeholder: "質問を書く（80文字以内）",
          aria: { label: "質問（80文字以内）", describedby: "circle-question-rules" } %>
        <div class="cb-circle-questions__form-footer">
          <span class="cb-circle-questions__counter"><span id="counter"><%= @question.content.to_s.length %></span> / 80文字</span>
          <%= f.button type: 'submit', class: 'cb-circle-questions__submit',
            data: { confirm: 'この内容でよろしいですか？', disable_with: '更新中...' } do %>
            <%= lucide_icon "arrow-right", **{ "aria-hidden" => "true" } %>質問する
          <% end %>
        </div>
      <% end %>
    </section>
  <% else %>
    <p class="cb-circle-tab-empty">現在、このサークルは質問を受け付けていません。</p>
  <% end %>

  <% if owner %>
    <div class="cb-circle-questions__share">
      <%= link_to("https://twitter.com/share?url=#{request.url}&text=質問を募集中です！%0a%0a%23質問コーナー%20%23サークルブック%0a", target: '_blank', rel: 'noopener') do %>
        <%= lucide_icon "share-2", **{ "aria-hidden" => "true" } %>質問をXで募集する
      <% end %>
    </div>
  <% end %>

  <section class="cb-circle-questions__feed" aria-labelledby="circle-questions-heading">
    <h2 id="circle-questions-heading">寄せられた質問</h2>
    <% if @questions.none? && !owner %>
      <p class="cb-circle-tab-empty">まだ質問はありません。</p>
    <% end %>
    <ul class="cb-circle-questions__list">
      <% @questions.each do |question| %>
        <li class="cb-circle-questions__row">
          <%= link_to user_question_path(@user, question), class: 'cb-circle-questions__link' do %>
            <span class="cb-circle-questions__status<%= ' cb-circle-questions__status--answered' if !question.answer.nil? %>">
              <%= question.answer.nil? ? '未回答' : '回答済み' %>
            </span>
            <span class="cb-circle-questions__text"><%= question.content %></span>
            <%= lucide_icon "chevron-right", **{ "aria-hidden" => "true" } %>
          <% end %>
          <% if can_manage_circle?(@user) %>
            <%= link_to(question.answer.present? ? "回答を編集する" : "回答する", user_question_path(@user, question, anchor: "question-answer"), class: "cb-circle-questions__edit cb-text-link") %>
          <% end %>
        </li>
      <% end %>
      <% if owner %>
        <% samples = { first: @question_first, second: @question_second, third: @question_third } %>
        <% visible_questions = @questions.map(&:content) %>
        <% samples.reject { |_sample, content| visible_questions.include?(content) }.each do |sample, content| %>
          <li class="cb-circle-questions__row">
            <%= link_to({ controller: :questions, action: :question, sample: sample }, class: "cb-circle-questions__link") do %>
              <span class="cb-circle-questions__status">未回答</span>
              <span class="cb-circle-questions__text"><%= content %></span>
              <%= lucide_icon "chevron-right", **{ "aria-hidden" => "true" } %>
            <% end %>
          </li>
        <% end %>
      <% end %>
    </ul>
  </section>

  <%= render "/layouts/ad_square" %>
  <div class="ad_space"></div>
  <%= paginate @questions %>
<% end %>

<%# Keep the existing halfwidth punctuation handling, without re-triggering the same change event. %>
<script>
  (() => {
    const input = document.getElementById('input-text');
    const counter = document.getElementById('counter');
    if (!input || !counter) return;

    const count = () => { counter.textContent = Array.from(input.value).length; };
    input.addEventListener('input', count);
    input.addEventListener('change', () => {
      input.value = input.value.replace(/["#$%&'()=<>,.?_\[\]{}@^~\\]/g, char => String.fromCharCode(char.charCodeAt(0) + 65248));
      count();
    });
    count();
  })();
</script>
<%= render 'shared/structured_data', data: questions_listing_structured_data(@questions, user: @user) %>
