<main class="chat-shell"><div class="chat-card cb-system-panel">
  <h1>メールアドレスの確認（サークル主催者）</h1>
  <% if @valid %>
    <%= form_with url: admin_user_email_verification_path, method: :patch, local: true do |f| %>
      <%= hidden_field_tag :token, @token %>
      <%= f.submit 'メールアドレスを確認する', class: 'chat-button' %>
    <% end %>
  <% else %>
    <p class="cb-warning-notice">リンクが無効または期限切れです。確認メールを再送してください。</p>
    <%= link_to '確認メールの再送', admin_user_email_verification_path %>
  <% end %>
</div></main>
