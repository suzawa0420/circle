<% set_meta_tags title: "お問い合わせ内容の編集｜#{@user.name}", noindex: true %>
<main class="user_main inquiry-settings"><div class="container">
  <h1 class="management-heading">お問い合わせ内容の編集</h1>
  <%= render 'users/parts/user_switching', user: @user, url_path: 'inquiry_settings' %>
  <p>参加者が最初のメッセージを送る前に、サークルからの自動案内として表示します。</p>
  <div class="chat-card">
    <h2>活動予定のご案内</h2>
    <p>登録済みの今後の活動予定を、開催日が近い順に3件まで自動表示します。4件以上ある場合は、すべての活動予定へのリンクも表示します。</p>
    <%= link_to '活動予定を管理する', user_schedules_path(@user), class: 'cb-text-link' %>
  </div>
  <div class="chat-card">
    <%= form_with model: @user, url: inquiry_settings_path(@user), method: :patch, local: true do |f| %>
      <% if @user.errors.any? %><div class="cb-alert cb-alert--error" role="alert"><%= @user.errors.full_messages.join('、') %></div><% end %>
      <%= f.label :template, '主催者からのご案内・確認事項' %>
      <%= f.text_area :template, rows: 10, maxlength: 2000, placeholder: "お問い合わせありがとうございます。以下の内容を記入してお送りください。\n・お名前（ニックネーム）\n・年代\n・経験の有無\n・参加希望日", aria: { describedby: 'inquiry-settings-help' } %>
      <p id="inquiry-settings-help">2000文字以内。未設定の場合は表示しません。以前のお問い合わせテンプレートを引き継いでいます。URLは入力できません。</p>
      <p>自動案内は最初の問い合わせ時に会話へ保存されます。設定の変更は、それ以降の新しい問い合わせに反映されます。</p>
      <%= f.submit '自動案内を保存する', class: 'cb-button' %>
    <% end %>
  </div>
  <%= link_to 'マイページに戻る', "/users/#{@user.id}/mypage", class: 'cb-text-link' %>
</div></main>
