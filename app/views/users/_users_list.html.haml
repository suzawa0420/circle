- if admin_user_signed_in? && current_admin_user.first_user
  .post_message
    = link_to(circle_path(current_admin_user.first_user)) do
      = circle_avatar_tag current_admin_user.first_user, class:'post_image_icon'
    = link_to(new_circle_blog_path(current_admin_user.first_user)) do
      .post_link サークル活動をつぶやく！

- listing_data = @listing_data || CircleListingData.new(@users)
- users = listing_data.users
%ul
  - users.each.with_index(1) do |user, i|
    %li.user_item_wrap
      = link_to(circle_path(user.id)) do
        .header_user_list.ribbon-wrapper
          .header_img_wrap
            = circle_listing_header_image(user, first: i == 1)
          .ribbon-content
            - if user.switch == "募集中"
              %span.ribbon.green= user.switch
            - else
              %span.ribbon.red= user.switch
          .tag_btn_list.slide_content
          = image_tag circle_listing_image_url(user, 'profile'), class: 'image_icon', alt: '', width: 160, height: 160, loading: 'lazy', decoding: 'async', data: { original_src: user.pic_profile.url }
          - if user.user_time.present?
            .post-bottom.user_updated
              更新日：#{time_tag user.user_time.to_date}
        .users-index-item.user_list_wrap
          .user-content
            .user_list_wrapper
              .list_01
                %h2.user_name= user.name.truncate(24)
            .list_cnts
              .list_04.recruitment_txt
                %span.user_recruitment= user.recruitment.truncate(110)
              - if listing_data.review_count(user).positive?
                = render "layouts/review_score", review_score: user.review_score.to_f, reviews_count: listing_data.review_count(user)
              - if user.cost.present?
                .list_02
                  %span= "参加費：#{user.cost.to_s.truncate(80)}"
              - if user.average_age.present?
                .list_02
                  %span= "参加者の年代：#{user.average_age.to_s.truncate(60)}"
              .list_02
                %span.user_schedule
                  %i.fa.fa-tags.icon_c
                  = user.event.txt
              .list_03
                %span.user_area
                  %i.fa.fa-map-marker.icon_c
                  = user.prefecture.name
                  - if user.prefecture_sub_id.present?
                    ・#{user.prefecture_sub.name}
                  = "：" if user.area.present?
                  = user.area
              .list_02
                %span.user_schedule
                  %i.fa.fa-calendar.icon_c
                  = user.schedule
                - if user.switch == "募集中"
                  - listing_data.schedules_for(user).each do |schedule|
                    .text_slide.user_item_schedule
                      ・#{Time.parse(schedule.day).strftime("%-m月%-d日(#{%w(日 月 火 水 木 金 土)[Time.parse(schedule.day).wday]})")}
                      - if schedule.time_s.present?
                        = schedule.time_s.strftime('%-H:%M')
                        \-#{schedule.time_e.strftime('%-H:%M') if schedule.time_e.present?}
                      = schedule.venue



      .tag_list_wrap
        %ul.tag_list_content
          %li
            = link_to("/#{user.event.ruby}") do
              = user.event.name
          %li
            = link_to("/prefectures/#{user.prefecture.kana}") do
              = user.prefecture.name
          - if user.prefecture_sub_id.present?
            %li
              = link_to("/prefectures/#{user.prefecture_sub.kana}") do
                = user.prefecture_sub.name
          - if user.listing_tags.present?
            - user.listing_tags.each do |tag|
              %li
                = link_to("/tag/#{tag.id}") do
                  = tag.name







    - if i == 5 || i == 10 || i == 15
      %li.list_ad
        = render "/layouts/ad_square"
= render "/layouts/ad_square"
= paginate users
