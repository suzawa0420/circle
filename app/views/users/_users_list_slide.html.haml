%ul.user_slide_wrap
  - users.first(5).each do |user|
    = link_to(circle_path(user.id)) do
      %li.user_slide_list
        .user_list_header
          = circle_avatar_tag user, class:'image_icon'
          %h3.user_name= user.name.truncate(20)
        .clear
        .list_02
          %span.user_area
            = lucide_icon "users"
            = user.event.name
        .list_02
          %span.user_schedule
            = lucide_icon "calendar-days"
            = user.schedule
        .list_03
          %span.user_area
            = lucide_icon "map-pin"
            = user.area
