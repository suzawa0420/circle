- preview = !!level_up[:preview]
- dialog_id = preview ? 'circle-level-preview' : 'circle-level-up'
%dialog.circle-level-up{ id: dialog_id, "aria-labelledby" => "#{dialog_id}-title", "aria-describedby" => "#{dialog_id}-benefit", data: { circle_level_up: preview ? "false" : "true" } }
  .circle-level-up__confetti{ "aria-hidden" => "true" }
  .circle-level-up__body
    %button.circle-level-up__x{ type: "button", data: { level_up_close: true }, "aria-label" => "ポップアップを閉じる" }
      = lucide_icon "x", **{ "aria-hidden" => "true" }
    .circle-level-up__emblem{ "aria-hidden" => "true" }
      = lucide_icon "trophy"
    - if preview
      %h2{ id: "#{dialog_id}-title" } レベルアップのお祝い演出
      %p.circle-level-up__subtitle 演出のお試しです。現在のレベルは変わりません。
    - elsif level_up[:profile_completion_bonus]
      %h2{ id: "#{dialog_id}-title" } サークル情報の入力が完了しました！
      %p.circle-level-up__subtitle 初回特典として5ポイント獲得！
    - else
      %h2{ id: "#{dialog_id}-title" } おめでとうございます！
      %p.circle-level-up__subtitle サークルがレベルアップしました
    - if preview
      .circle-level-up__levels{ "aria-label" => "現在のレベル#{level_up[:to]}" }
        %span.circle-level-up__new{ "aria-hidden" => "true" }
          %small Lv.
          = level_up[:to]
    - elsif level_up[:to] > level_up[:from]
      .circle-level-up__levels{ "aria-label" => "レベル#{level_up[:from]}から#{level_up[:to]}へレベルアップ" }
        %span.circle-level-up__old{ "aria-hidden" => "true" }
          %small Lv.
          = level_up[:from]
        %span.circle-level-up__arrow{ "aria-hidden" => "true" }
          = lucide_icon "arrow-right"
        %span.circle-level-up__new{ "aria-hidden" => "true" }
          %small Lv.
          = level_up[:to]
    - else
      .circle-level-up__levels{ "aria-label" => "5ポイント獲得" }
        %span.circle-level-up__new{ "aria-hidden" => "true" }
          ＋5
          %small ポイント
    %button.circle-level-up__replay{ type: "button", hidden: true, data: { level_up_replay: true } } お祝いの演出をもう一度見る
    %p.circle-level-up__benefit{ id: "#{dialog_id}-benefit" }
      レベルが高いほど、人気順で
      %br
      上位に表示されやすくなります
    %p.circle-level-up__invitation
      次の活動予定を登録して、
      %br
      参加のきっかけを増やしましょう。
    = link_to new_user_schedule_path(@user), class: "circle-level-up__primary", autofocus: true do
      = lucide_icon "calendar-plus", **{ "aria-hidden" => "true" }
      スケジュールを登録する
    %button.circle-level-up__close{ type: "button", data: { level_up_close: true } } 閉じる
