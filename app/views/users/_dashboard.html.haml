- unanswered_count = @questions_current_nil.count
- can_add_circle = @ng_accounts.count == 0 && @admin_user.users.count < 5 && (@admin_user.check.blank? || @admin_user.check == 0)
.dashboard-heading
  %div
    %h1 マイページ

%section.dashboard-circle{ "aria-label" => "管理中のサークル" }
  .dashboard-circle__top
    .dashboard-circle__information
      - if admin_user_signed_in? && @user.admin_user_id == current_admin_user.id
        = render "users/parts/user_switching", user: @user
        %p.dashboard-circle__location= [@user.prefecture&.name, @user.event&.name].compact.join(" · ")
      - else
        .dashboard-circle__identity
          - if @user.pic_profile.present?
            = image_tag @user.pic_profile.url, alt: "", class: "dashboard-circle__avatar"
          - else
            .dashboard-circle__avatar.dashboard-circle__avatar--empty{ "aria-hidden" => "true" }= @user.name.to_s.first
          %div.dashboard-circle__name
            %h2= @user.name
            %p= [@user.prefecture&.name, @user.event&.name].compact.join(" · ")
    .dashboard-circle__tools
      = link_to edit_user_path(@user), class: "dashboard-copy" do
        %i.fa.fa-pencil{ "aria-hidden" => "true" }
        編集
      = link_to circle_path(@user), class: "dashboard-copy" do
        %i.fa.fa-external-link{ "aria-hidden" => "true" }
        公開ページ
  .dashboard-circle__status
    - if @user.moderation_status == "blocked"
      %span.dashboard-status.dashboard-status--attention 公開停止中
    - elsif @user.moderation_status == "review"
      %span.dashboard-status.dashboard-status--attention 確認中
    - elsif @user.publication_status == "draft"
      %span.dashboard-status.dashboard-status--attention 公開準備中
    - elsif @user.publicly_visible?
      %span.dashboard-status 公開中
    - else
      %span.dashboard-status.dashboard-status--attention 非公開
    - if @user.switch.present?
      %span.dashboard-recruitment= @user.switch
  - public_url = @user.link&.unique_id.present? ? "https://circle-book.com/u/#{@user.link.unique_id}" : "https://circle-book.com#{circle_path(@user)}"
  .dashboard-circle__url
    %h3
      %i.fa.fa-link{ "aria-hidden" => "true" }
      公開URL
    .dashboard-circle__url-row
      = link_to public_url, class: "copyTarget dashboard-circle__url-value", "aria-label" => "公開URL（横にスライドして全文を確認）" do
        = public_url
      %button.dashboard-url-copy.dashboard-copy{ type: "button", "aria-label" => "サークルの公開URLをコピー" }
        %i.fa.fa-copy{ "aria-hidden" => "true" }
        %span コピー

- if @user.publication_status == "draft"
  .dashboard-notice
    %strong 公開まで、あと少し
    %p= "未入力の項目：#{@user.missing_publication_fields.join('、')}"
    = link_to "不足項目を入力する →", edit_user_path(@user)
- if @user.moderation_status == "review"
  .dashboard-notice
    %strong 内容を確認しています
    %p サークルとブログは一時的に非公開です。
- elsif @user.moderation_status == "blocked"
  .dashboard-notice
    %strong このサークルは公開停止中です
- if @respond_check_count > 0
  .dashboard-notice
    %strong= "返信についての報告が#{@respond_check_count}件あります"
    %p 応募者から返信が届いていないと報告されています。
    = link_to "お問い合わせを確認する →", "/users/#{@user.id}/contact_list"
= render "/users/alert"

- if admin_user_signed_in? && @user.admin_user_id == current_admin_user.id
  = render "users/level_card", user: @user, breakdown: [["スケジュール登録", 0.1, @schedule_point], ["ブログ投稿", 0.2, @blog_point], ["Q&Aの回答", 0.3, @qa_point], ["高評価の口コミ", 2.0, @review_point], ["メッセージ未返信", -30.0, -@respond_point]], rivals: @users.includes(:event, :prefecture).limit(5)

%section.dashboard-section
  .dashboard-section__heading
    %h2 活動を管理
    %p 日々の更新はこちらから
  .dashboard-action-grid
    = render "dashboard_action", title: "ブログを書く", description: "活動の様子を投稿", icon: "pencil", path: new_circle_blog_path(@user)
    = render "dashboard_action", title: "スケジュール", description: "活動日を登録・編集", icon: "calendar", path: user_schedules_path(@user)
    - if @schedules.present?
      = render "dashboard_action", title: "出欠管理", description: "メンバーの参加を確認", icon: "users", path: attendances_path(@user.unique_id)

%section.dashboard-section
  .dashboard-section__heading
    %h2 参加者とのやりとり
  .dashboard-action-list
    - if @user.user_contacts.present?
      = render "dashboard_action", title: "お問い合わせ管理", description: "応募・問い合わせを確認", icon: "envelope-o", path: "/users/#{@user.id}/contact_list", badge: (@respond_check_count > 0 ? "要確認 #{@respond_check_count}" : nil)
    = render "dashboard_action", title: "質問コーナー", description: "質問の確認・回答", icon: "question-circle", path: user_questions_path(@user), badge: (unanswered_count > 0 ? "未回答 #{unanswered_count}" : nil)
    = render "dashboard_action", title: "口コミ・評価", description: "参加者の声を確認", icon: "comment-o", path: user_reviews_path(@user)

- if @user.event.matching != 0
  %section.dashboard-section
    .dashboard-section__heading
      %h2 対戦相手を探す
    .dashboard-action-list
      - match_url = @user.match.present? ? match_path(@user) : new_user_match_path(@user)
      = render "dashboard_action", title: "対戦相手の募集", description: "募集内容を作成・確認", icon: "flag-checkered", path: match_url
      = render "dashboard_action", title: "対戦相手の一覧", description: "ほかのチームを探す", icon: "search", path: matches_path

%section.dashboard-section
  .dashboard-section__heading
    %h2 サークルの設定
  .dashboard-action-list
    = render "dashboard_action", title: "リンク集", description: "SNSや関連リンクをまとめる", icon: "link", path: new_user_link_path(@user)
    = render "dashboard_action", title: "お問い合わせ内容の編集", description: "問い合わせ前の確認事項・自動案内を設定", icon: "comment-o", path: inquiry_settings_path(@user)
    - if can_add_circle
      = render "dashboard_action", title: "サークル新規追加", description: "別のサークルを管理する", icon: "plus-circle", path: "/user/add"

%section.dashboard-section.dashboard-account-settings
  .dashboard-section__heading
    %h2 アカウント設定
  .dashboard-action-list
    = render "dashboard_action", title: "メールアドレス・パスワード", description: "ログイン情報を変更する", icon: "lock", path: edit_admin_user_registration_path
