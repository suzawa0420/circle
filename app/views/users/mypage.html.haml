- set_meta_tags noindex: true, title: "マイページ"
.user_main.users-index.organizer-dashboard
  .container
    .mypage_wrap
      = render "dashboard"
      %details.dashboard-insights
        %summary
          %i.fa.fa-bar-chart{ "aria-hidden" => "true" }
          掲載状況・レベルの内訳
          %i.fa.fa-angle-down{ "aria-hidden" => "true" }
        .dashboard-insights__body
          = render "/users/analytics"
      = render "/layouts/ads/picte_mypage", user: @user
      .border
      = render "/layouts/ad_square"
      .ad_space
