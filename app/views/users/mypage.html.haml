- set_meta_tags noindex: true, title: "マイページ"
.user_main.users-index.organizer-dashboard
  .container
    .mypage_wrap
      = render "dashboard"
      - if @level_up
        = render "level_up", level_up: @level_up
      - if (affiliate_ad = affiliate_ad_for_organizer(@user))
        = render 'layouts/ads/affiliate', ad: affiliate_ad, placement: 'organizer_mypage'
      = render "/layouts/ad_square"
      .ad_space
