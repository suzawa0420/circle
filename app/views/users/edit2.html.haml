- set_meta_tags title: "活動エリア・カテゴリー", noindex: true
.main.users-edit
  .container
    %h1.cb-page-title 活動エリア・カテゴリー
    = render "users/parts/user_switching", user: @user
    .form.users-form
      = render "users/parts/step_bar"
      .form-body.cont-body
        - if @user.errors.any?
          .form-error
            以下の項目でエラーが発生いたしました。
            %br/
        - @user.errors.full_messages.each do |message|
          .form-error_message
            ・#{message}
        = form_for @user,:url => {controller: "users", action: "update2"} do |f|
          = f.fields_for :link do |fin|
            .label_item
              %span.label.label_danger> 必須
              アカウントID（半角英数字：4〜16文字）
              %br>/
              ※記号などは使用できません
            = fin.text_field :unique_id, id: 'change_order', class: 'form-control', placeholder: "circlebook"
          .edit02_warp
            %span.edit02_subtitle カテゴリー
            .check_boxes
              = f.collection_check_boxes(:tag_ids, @tags, :id, :name)
          - if @user.prefecture_id != 50
            = render "users/city_selection", f: f, prefecture: @prefecture, cities: @cities, selection_id: "main-cities"
          - if @user.prefecture_sub_id.present? && @user.prefecture_sub_id != 50
            = render "users/city_selection", f: f, prefecture: @sub_prefecture, cities: @sub_cities, selection_id: "sub-cities"
          = f.submit "更新する", data: { disable_with: '更新中...' }
