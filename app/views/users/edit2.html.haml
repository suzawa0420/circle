- set_meta_tags title: "メンバー・募集条件", noindex: true
.main.users-edit
  .container
    %h1.cb-page-title メンバー・募集条件
    = render "users/parts/user_switching", user: @user
    .form.users-form
      = render "users/parts/step_bar"
      .form-body.cont-body
        - if @user.errors.any?
          .form-error
            以下の項目でエラーが発生いたしました。
            %br/
        - @user.errors.full_messages.each do |message|
          .form-error_message
            ・#{message}
        = form_for @user,:url => {controller: "users", action: "update2"} do |f|
          = f.fields_for :link do |fin|
            .label_item
              %span.label.label_danger> 必須
              アカウントID（半角英数字：4〜16文字）
              %br>/
              ※記号などは使用できません
            = fin.text_field :unique_id, id: 'change_order', class: 'form-control', placeholder: "circlebook"
          %section.edit02_warp
            %h2.edit02_subtitle 現在のメンバー
            %p 現在活動しているメンバーの年齢層を選びます。
            .check_boxes
              = f.collection_check_boxes(:age_ids, Age.all, :id, :name)
            = render "users/member_composition_fields", f: f
          %section.edit02_warp
            %h2.edit02_subtitle 募集対象
            %p これから参加してほしい方に当てはまる項目を選びます。
            .check_boxes
              = f.collection_check_boxes(:group_ids, Group.all.order(:id => :asc), :id, :name)
          %section.edit02_warp
            %h2.edit02_subtitle 検索用タグ
            %p サークル探しの絞り込みに使われるタグです。
            .check_boxes
              = f.collection_check_boxes(:tag_ids, @tags, :id, :name)
          - if @user.prefecture_id != 50
            = render "users/city_selection", f: f, prefecture: @prefecture, cities: @cities, selection_id: "main-cities"
          - if @user.prefecture_sub_id.present? && @user.prefecture_sub_id != 50
            = render "users/city_selection", f: f, prefecture: @sub_prefecture, cities: @sub_cities, selection_id: "sub-cities"
          = f.submit "更新する", data: { disable_with: '更新中...' }
