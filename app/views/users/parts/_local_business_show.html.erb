<%
  reviews = user.reviews.to_a
  business = {
    '@context' => 'http://schema.org/',
    '@type' => 'LocalBusiness',
    '@id' => request.path,
    'name' => user.name.to_s,
    'description' => "#{user.prefecture.name}で活動している#{user.event.txt}",
    'image' => [user.pic_profile.url.to_s] +
      [user.gallery_01, user.gallery_02, user.gallery_03, user.gallery_04].filter_map { |gallery| gallery.url.presence } +
      [user.pic_header.url.to_s],
    'address' => {
      '@type' => 'PostalAddress',
      'addressCountry' => 'JP',
      'addressRegion' => user.prefecture.name
    },
    'priceRange' => user.cost.to_s
  }
  rating = review_aggregate_rating(user.review_score, review_count: reviews.size)
  if rating
    business['aggregateRating'] = rating
    business['review'] = reviews.first(5).map do |review|
      {
        '@type' => 'Review',
        'author' => { '@type' => 'Person', 'name' => review.member.present? ? review.member.nickname.to_s : 'ゲストユーザー' },
        'reviewBody' => review.comment.to_s
      }
    end
  end
%>
<script type="application/ld+json"><%= raw json_escape(business.to_json) %></script>

<% questions = user.questions.to_a %>
<% if questions.any? %>
  <%
    faq = {
      '@context' => 'https://schema.org',
      '@type' => 'FAQPage',
      'mainEntity' => questions.first(5).map do |question|
        {
          '@type' => 'Question',
          'name' => question.content.to_s,
          'acceptedAnswer' => {
            '@type' => 'Answer',
            'text' => question.answer.presence || '未回答の質問です。回答するまで、しばらくお待ちください。'
          }
        }
      end
    }
  %>
  <script type="application/ld+json"><%= raw json_escape(faq.to_json) %></script>
<% end %>
