- if admin_user_signed_in? && user.admin_user_id == current_admin_user.id
  .management-context
    %button.mobile-circle-trigger.management-circle-trigger{ type: "button", "aria-controls" => "mobile-circle-dialog", "aria-expanded" => "false", "aria-haspopup" => "dialog", "aria-label" => "管理するサークルを切り替え：#{user.name}" }
      = render "layouts/mobile_circle_avatar", circle: user
      %span.management-circle-trigger__content
        %span.management-circle-trigger__label 現在管理中のサークル
        %span.management-circle-trigger__name= user.name
      %span.management-circle-trigger__action
        切り替え
        %i.fa.fa-angle-down{ "aria-hidden" => "true" }
