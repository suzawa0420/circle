.user_profile_wrap
  = link_to(circle_path(user.id)) do
    = circle_avatar_tag user, class:'image_icon'
    .user_profile
      %h2.user_name= user.name.truncate(40)
    .reset
    .user_about
      .slide_content
        = lucide_icon "tags"
        = user.event.txt
      - if user.schedule.present?
        .slide_content
          = lucide_icon "calendar-days"
          = user.schedule
      - if user.prefecture_id.present?
        .slide_content
          = lucide_icon "map-pin"
          = user.prefecture.name
          = "・#{user.prefecture_sub.name}" if user.prefecture_sub_id.present?
          = "：#{user.area}" if user.area.present?
  .reset
