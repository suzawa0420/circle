- if page.current?
  %li.page-item.active
    = content_tag :span, page, class: 'page-link', 'aria-current': 'page', 'aria-label': "現在のページ：#{page}"
- else
  %li.page-item
    = link_to page, url, remote: remote, rel: (page.next? ? 'next' : (page.prev? ? 'prev' : nil)), class: 'page-link', 'aria-label': "#{page}ページ目"
