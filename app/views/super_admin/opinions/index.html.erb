<%= render 'webmasters/shared/page_header', title: 'ご意見箱', description: '利用者から運営に届いたご意見を、新しい順に表示します。' %>
<section class="wm-section"><h2>新しい窓口からのご意見（全 <%= @suggestions.total_count %> 件）</h2><p>週1回まとめて確認します。個別の返信は原則行いません。</p><div class="wm-list"><% @suggestions.each do |suggestion| %><article class="webmaster-card"><h3><%= SupportRequest::AUDIENCES[suggestion.audience] %>からのご意見</h3><p class="wm-meta"><%= suggestion.created_at.strftime('%Y/%m/%d %H:%M') %> ／ <%= SupportRequest::STATUSES[suggestion.status] %></p><%= render "webmasters/shared/submission_author", submission: suggestion %><div class="wm-body"><%= simple_format(h(suggestion.body)) %></div><div class="wm-actions"><%= link_to '詳細・対応状況', super_admin_support_request_path(suggestion) %></div></article><% end %></div><% if @suggestions.empty? %><p>新しい窓口からのご意見はありません。</p><% end %><%= paginate @suggestions, param_name: :suggestion_page %></section>
<section class="wm-section">
  <div class="wm-section-heading"><h2>ご意見一覧（全 <%= @opinions.total_count %> 件）</h2></div>
  <div class="wm-list">
    <% @opinions.each do |opinion| %>
      <article class="webmaster-card">
        <h3>
          <% if opinion.user %>
            <%= link_to opinion.user.name, circle_path(opinion.user) %>
          <% else %>
            投稿元サークルなし（削除済み・不明）
          <% end %>
        </h3>
        <p class="wm-meta">投稿日時：<%= opinion.created_at.in_time_zone.strftime('%Y/%m/%d %H:%M') %> ／ 投稿ID：<%= opinion.id %></p>
        <% if opinion.user&.admin_user %>
          <p class="wm-submission-author">投稿元サークルの現在の主催者：<%= link_to "#{opinion.user.admin_user.nickname.presence || '名前未設定'}（ID：#{opinion.user.admin_user_id}）", super_admin_account_path(opinion.user.admin_user, kind: 'owner') %></p>
        <% end %>
        <div class="wm-body"><%= simple_format(h(opinion.opinion)) %></div>
      </article>
    <% end %>
  </div>
  <% if @opinions.empty? %><%= render 'webmasters/shared/empty', message: 'ご意見はまだありません。' %><% end %>
  <%= paginate @opinions %>
</section>
