- set_meta_tags noindex: true
.main.users-index
  .container
    %h2 サークル管理（SuperAdmin）
    %h3 確認待ちのサークル
    - @review_circles.each do |circle|
      %p
        = link_to circle.name, circle_path(circle)
        = button_to "確認済みにする", super_admin_circle_moderation_path(circle), method: :patch, params: { moderation_status: "clear" }
        = button_to "停止", super_admin_circle_moderation_path(circle), method: :patch, params: { moderation_status: "blocked" }
    %h3 確認待ちのブログ
    - @review_blogs.each do |blog|
      %p
        = link_to blog.title, circle_blog_path(blog.user, blog)
        = button_to "確認済みにする", super_admin_blog_moderation_path(blog), method: :patch, params: { moderation_status: "clear" }
        = button_to "停止", super_admin_blog_moderation_path(blog), method: :patch, params: { moderation_status: "blocked" }
    %h3 公開停止中のサークル
    - @blocked_circles.each do |circle|
      %p
        = link_to circle.name, circle_path(circle)
        = button_to "停止を解除", super_admin_circle_moderation_path(circle), method: :patch, params: { moderation_status: "clear" }
    %h3 公開停止中のブログ
    - @blocked_blogs.each do |blog|
      %p
        = link_to blog.title, circle_blog_path(blog.user, blog)
        = button_to "停止を解除", super_admin_blog_moderation_path(blog), method: :patch, params: { moderation_status: "clear" }
    .table_list
      %table.table.table-bordered
        %tr
          %th サークル名
          %th メールアドレス
          %th 登録日
          %th ユーザー数
          %th 操作
        - @admin_users.each do |admin_user|
          - circle = admin_user.users.first
          %tr
            %td= circle&.name
            %td= admin_user.email
            %td= admin_user.created_at.strftime("%Y/%m/%d")
            %td= admin_user.users.count
            %td= link_to "削除", super_admin_circle_path(admin_user.id), method: :delete, data: { confirm: "#{circle&.name} を削除しますか？この操作は取り消せません。" }, class: "btn btn-danger btn-sm"
= paginate @admin_users
