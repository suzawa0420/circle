<%= render 'webmasters/shared/page_header', title: 'メッセージのやり取り', description: '発言者と日時を確認しながら、会話を閲覧できます。' %>
<%= link_to 'メッセージ一覧に戻る', super_admin_conversations_path, class: 'wm-button wm-button--secondary' %>
<section class="wm-section webmaster-card">
  <h2><%= link_to @conversation.user.name, circle_path(@conversation.user) %></h2>
  <dl class="wm-details"><dt>主催者</dt><dd><%= @conversation.user.admin_user.nickname.presence || 'ニックネーム未登録' %></dd><dt>参加者</dt><dd><%= link_to @conversation.member.nickname, member_profile_path(@conversation.member) %></dd><dt>会話の状態</dt><dd><%= @conversation.blocked? ? 'ブロック中' : (@conversation.accepted_at ? '受付済み' : '主催者の初回返信前') %></dd></dl>
  <div class="wm-actions"><%= link_to '主催者の管理', super_admin_account_path(@conversation.user.admin_user, kind: 'owner'), class: 'wm-button wm-button--secondary' %><%= link_to '参加者の管理', super_admin_account_path(@conversation.member), class: 'wm-button wm-button--secondary' %></div>
  <p class="wm-meta">運営による閲覧です。相手の既読状態には反映されません。</p>
</section>
<section class="wm-section wm-thread wm-conversation">
  <div class="wm-section-heading"><h2>会話履歴</h2><span class="wm-badge"><%= @messages.total_count %>件</span></div>
  <%= paginate @messages %>
  <% @messages.each do |message| %>
    <article class="webmaster-card wm-message wm-message--<%= message.sender_role %>">
      <div class="wm-card-heading"><span class="wm-badge"><%= message.sender_role == 'owner' ? '主催者' : '参加者' %></span><time class="wm-meta" datetime="<%= message.created_at.iso8601 %>"><%= message.created_at.strftime('%Y/%m/%d %H:%M') %></time></div>
      <div class="wm-body"><%= chat_message_body(message.body) %></div>
    </article>
  <% end %>
  <% if @messages.empty? %><%= render 'webmasters/shared/empty', message: 'メッセージはありません。' %><% end %>
  <%= paginate @messages %>
</section>
