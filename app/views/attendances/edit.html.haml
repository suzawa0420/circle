- set_meta_tags noindex: true,title: "【限定公開】出欠確認｜#{@user.name}",og: {title: "【限定公開】出欠確認｜#{@user.name}",description: "#{@user.prefecture.name}で活動している#{@user.event.name}サークル｜#{@user.name}", image: image_url("/images/attendance_ogp.png")}
.user_main.users-index.attendance-page.attendance-response-page
  .container
    .attendance-response-heading
      %h1 出欠を変更する
      %p 日程ごとに参加・不参加を選んでください。
    .attendance-response-panel
      .attendance-response-content
        = form_for(@name, url: attendance_path(@user.unique_id, @name.id), html: {method: 'patch', class: 'attendance-response-form'}) do |f|
          = render "attendances/person_fields", f: f
          - @schedules.each do |schedule|
            - if @name.name_schedules.find_by(schedule_id: schedule.id).blank?
              / 未登録
              - if schedule.recruitment_numbers.present?
                / 定員設定あり
                - if schedule.name_schedules.where(answer: 1).count >= schedule.recruitment_numbers && schedule.recruitment_numbers != 0
                  / 満員の場合は非表示
                - else
                  / 募集中
                  = f.fields_for :name_schedules, schedule.name_schedules.build do |name_schedule|
                    = render "attendances/schedule_fields", f: name_schedule, schedule: schedule

              - else
                / 定員設定なし
                = f.fields_for :name_schedules, schedule.name_schedules.build do |name_schedule|
                  = render "attendances/schedule_fields", f: name_schedule, schedule: schedule

          = f.fields_for :name_schedules do |name_schedule|
            - if name_schedule.object.schedule.day.present? && name_schedule.object.schedule.day >= Date.current.iso8601
              / 今日以降のみ表示
              - if name_schedule.object.schedule.recruitment_numbers.present?
                / 定員設定あり
                - if name_schedule.object.answer == 1
                  / 参加で回答済み
                  = render "attendances/schedule_fields", f: name_schedule, schedule: name_schedule.object.schedule
                - elsif name_schedule.object.schedule.name_schedules.where(answer: 1).count >= name_schedule.object.schedule.recruitment_numbers && name_schedule.object.schedule.recruitment_numbers != 0
                  / 満員の場合は非表示
                - else
                  / 募集中
                  = render "attendances/schedule_fields", f: name_schedule, schedule: name_schedule.object.schedule
              - else
                / 定員設定なし
                = render "attendances/schedule_fields", f: name_schedule, schedule: name_schedule.object.schedule
            / 今日以降
          / 子
          .attendance-submit-actions
            = f.submit "変更を保存する", class: "attendance-save-button", data: { disable_with: '保存中...' }
            = link_to "出欠一覧に戻る", attendances_path(@user.unique_id), class: "attendance-return-link"
        / 親
      .delete_btn
        = link_to(attendance_path(@user.unique_id, @name.id), method: :delete, data: {confirm: "#{ @name.name }さんの登録を削除しますか？"}) do
          = lucide_icon "trash-2"
          = @name.name
          さんの登録を削除する
