[Unit]
Description=Circle Book Unicorn (AL2023)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=nginx
WorkingDirectory=/var/www/circle
Environment=RAILS_ENV=production
Environment=BUNDLE_PATH=/var/www/circle/vendor/bundle
Environment=PATH=/opt/circle/ruby-3.3.12/bin:/opt/circle/node-v24.21.0-linux-x64/bin:/usr/local/bin:/usr/bin:/bin
Environment=AWS_EC2_METADATA_DISABLED=true
UMask=0007
ExecStart=/opt/circle/ruby-3.3.12/bin/bundle exec unicorn -c config/unicorn.rb -E production
KillSignal=SIGQUIT
KillMode=mixed
TimeoutStopSec=90
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
